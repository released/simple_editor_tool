IDD_MULTI_SEARCH DIALOGEX 0, 0, 650, 390
STYLE DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_MINIMIZEBOX
CAPTION "Find in open files / folder"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "Find:", -1, 8, 10, 30, 12
    EDITTEXT 1900, 42, 8, 300, 14, ES_AUTOHSCROLL | WS_TABSTOP
    COMBOBOX 1901, 350, 8, 140, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    COMBOBOX 1902, 498, 8, 144, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    COMBOBOX 1903, 8, 32, 140, 70, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    EDITTEXT 1904, 156, 32, 414, 14, ES_AUTOHSCROLL | WS_TABSTOP
    PUSHBUTTON "Browse...", 1905, 578, 30, 64, 18
    LTEXT "Include:", -1, 8, 58, 36, 12
    EDITTEXT 1906, 46, 56, 180, 14, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "Exclude:", -1, 238, 58, 40, 12
    EDITTEXT 1907, 280, 56, 180, 14, ES_AUTOHSCROLL | WS_TABSTOP
    AUTOCHECKBOX "Subfolders", 1910, 472, 56, 75, 14, WS_TABSTOP
    AUTOCHECKBOX "Match case", 1911, 8, 80, 80, 14, WS_TABSTOP
    AUTOCHECKBOX "Whole word", 1912, 100, 80, 90, 14, WS_TABSTOP
    DEFPUSHBUTTON "Find all", IDOK, 350, 78, 90, 18
    PUSHBUTTON "Cancel search", 1913, 448, 78, 90, 18
    PUSHBUTTON "Errors...", 1908, 546, 78, 96, 18
    CONTROL "", 1909, "SysListView32", WS_TABSTOP | WS_BORDER | LVS_REPORT | LVS_OWNERDATA, 8, 104, 634, 222
    EDITTEXT 1914, 8, 334, 634, 24, ES_MULTILINE | ES_READONLY | ES_AUTOVSCROLL | WS_VSCROLL
    LTEXT "Text offsets use the normalized UTF-8 editor buffer. Hex offsets are physical byte addresses.", -1, 8, 370, 530, 12
    PUSHBUTTON "Close", IDCANCEL, 554, 364, 88, 18
END

IDD_PREFERENCES DIALOGEX 0, 0, 480, 336
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Preferences"
FONT 9, "Segoe UI"
BEGIN
    PUSHBUTTON "Content font...", 2000, 8, 8, 100, 18
    LTEXT "", 2001, 120, 12, 160, 12
    COMBOBOX 2002, 294, 8, 178, 80, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    AUTOCHECKBOX "Wrap text", 2003, 8, 38, 92, 14, WS_TABSTOP
    AUTOCHECKBOX "Show whitespace / EOL", 2004, 112, 38, 160, 14, WS_TABSTOP
    AUTOCHECKBOX "Insert Tab characters", 2005, 294, 38, 170, 14, WS_TABSTOP
    LTEXT "Tab width (1-16):", -1, 8, 64, 108, 12
    EDITTEXT 2006, 120, 62, 60, 14, ES_NUMBER | WS_TABSTOP
    LTEXT "Default zoom % (Hex / Text / Compare):", -1, 8, 88, 248, 12
    EDITTEXT 2010, 270, 86, 60, 14, ES_NUMBER | WS_TABSTOP
    EDITTEXT 2011, 340, 86, 60, 14, ES_NUMBER | WS_TABSTOP
    EDITTEXT 2012, 410, 86, 62, 14, ES_NUMBER | WS_TABSTOP
    AUTOCHECKBOX "Restore workspace tabs at startup", 2007, 8, 114, 230, 14, WS_TABSTOP
    AUTOCHECKBOX "Save separate draft recovery snapshots", 2008, 244, 114, 228, 14, WS_TABSTOP
    LTEXT "Snapshot interval, seconds (10-600):", -1, 8, 140, 242, 12
    EDITTEXT 2009, 270, 138, 60, 14, ES_NUMBER | WS_TABSTOP
    LTEXT "Snapshots preserve copies; originals change only through explicit Save.", -1, 8, 162, 464, 12
    LTEXT "Shortcuts: Ctrl / Shift / Alt + letter, digit or F1-F24. None disables a binding.", -1, 8, 184, 464, 12
    LTEXT "New file:", -1, 8, 208, 70, 12
    EDITTEXT 2020, 84, 206, 130, 14, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "Open files:", -1, 244, 208, 76, 12
    EDITTEXT 2021, 326, 206, 146, 14, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "Save:", -1, 8, 232, 70, 12
    EDITTEXT 2022, 84, 230, 130, 14, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "Find:", -1, 244, 232, 76, 12
    EDITTEXT 2023, 326, 230, 146, 14, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "Replace:", -1, 8, 256, 70, 12
    EDITTEXT 2024, 84, 254, 130, 14, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "Find in files:", -1, 244, 256, 76, 12
    EDITTEXT 2025, 326, 254, 146, 14, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "Reopen file:", -1, 8, 280, 70, 12
    EDITTEXT 2026, 84, 278, 130, 14, ES_AUTOHSCROLL | WS_TABSTOP
    DEFPUSHBUTTON "Save preferences", IDOK, 256, 308, 128, 18
    PUSHBUTTON "Cancel", IDCANCEL, 392, 308, 80, 18
END

