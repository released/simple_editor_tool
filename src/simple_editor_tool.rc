IDD_TEXT_REVIEW_NOTE DIALOGEX 0, 0, 460, 240
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Difference review note"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "", 2902, 8, 8, 444, 20
    EDITTEXT 2900, 8, 32, 444, 148, ES_MULTILINE | ES_AUTOVSCROLL | ES_WANTRETURN | WS_VSCROLL
    AUTOCHECKBOX "Reviewed (does not resolve merge conflicts)", 2901, 8, 186, 444, 18
    PUSHBUTTON "Clear note", 2903, 8, 214, 86, 18
    DEFPUSHBUTTON "Apply", IDOK, 270, 214, 86, 18
    PUSHBUTTON "Cancel", IDCANCEL, 366, 214, 86, 18
END

