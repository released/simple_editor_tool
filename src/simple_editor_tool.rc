IDD_SEARCH DIALOGEX 0, 0, 390, 245
STYLE DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Find / Replace"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "Find:", -1, 8, 12, 56, 12
    COMBOBOX IDC_SEARCH_TEXT, 68, 10, 312, 100, CBS_DROPDOWN | CBS_AUTOHSCROLL | WS_VSCROLL | WS_TABSTOP
    LTEXT "Replace with:", -1, 8, 36, 56, 12
    EDITTEXT IDC_REPLACE_TEXT, 68, 34, 312, 14, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "Mode:", -1, 8, 60, 56, 12
    COMBOBOX IDC_SEARCH_MODE, 68, 58, 312, 120, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "Scope:", -1, 8, 84, 56, 12
    COMBOBOX IDC_SEARCH_SCOPE, 68, 82, 312, 80, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    CONTROL "Match case", IDC_SEARCH_CASE, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 8, 108, 85, 14
    CONTROL "Whole word", IDC_SEARCH_WORD, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 100, 108, 85, 14
    CONTROL "Selection only", IDC_SEARCH_SELECTION, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 192, 108, 100, 14
    CONTROL "Wrap", IDC_SEARCH_WRAP, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 304, 108, 70, 14
    DEFPUSHBUTTON "Find Next", IDOK, 8, 134, 85, 18
    PUSHBUTTON "Find Previous", IDC_SEARCH_PREVIOUS, 100, 134, 85, 18
    PUSHBUTTON "Count", IDC_SEARCH_COUNT, 192, 134, 85, 18
    PUSHBUTTON "Find All", IDC_SEARCH_ALL, 284, 134, 96, 18
    PUSHBUTTON "Replace", IDC_REPLACE_ONE, 8, 162, 85, 18
    PUSHBUTTON "Replace All", IDC_REPLACE_ALL, 100, 162, 85, 18
    PUSHBUTTON "Preview All...", IDC_SEARCH_PREVIEW, 192, 162, 85, 18
    PUSHBUTTON "Close / Cancel", IDCANCEL, 284, 162, 96, 18
    LTEXT "Current scope follows the active tab. All open: text editors only; no disk writes.", IDC_SEARCH_STATUS, 8, 188, 372, 27
    CONTROL "Multiline literal input", IDC_SEARCH_MULTILINE, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 8, 220, 180, 14
END

