    static int RunStructured(const std::filesystem::path& root) {
        int failures = 0; const auto check = [&](bool ok,const wchar_t* label) { std::wcout << (ok ? L"PASS: " : L"FAIL: ") << label << L'\n'; if (!ok) ++failures; };
        const auto left = root / L"fields-left.json",right = root / L"fields-right.json"; const std::string a = "{\"a\":1,\"b\":2}",b = "{\"b\":2.00,\"a\":1}"; Write(left,{a.begin(),a.end()}); Write(right,{b.begin(),b.end()});
        auto* workspace = new CWorkspaceFrame(false); AfxGetApp()->m_pMainWnd = workspace; workspace->NewComparisonInputs(left.wstring(),right.wstring(),L"",7,true); auto* frame = workspace->sessions_[0]; auto& view = frame->advanced_;
        check(Wait(frame) && view.structured_ && view.structured_->different == 0 && view.visible_.empty(),L"JSON comparison is available through native left/right paths and normalized values");
        check(!view.OutputEditor() && !view.output_.IsWindowVisible() && !view.take_left_.IsWindowVisible() && !view.save_.IsWindowVisible(),L"structured comparison exposes read-only field results without unsafe merge/save controls");
        const std::string changed = "{\"b\":3,\"a\":\"1\"}"; Write(right,{changed.begin(),changed.end()}); frame->OnCompareRun(); check(Wait(frame) && view.structured_->different == 2 && view.visible_.size() == 2 && view.Cell(0,0).find(L"a") != std::wstring::npos,L"JSON recompare reports exact field paths and type/value changes"); view.Navigate(false); check(view.rows_.GetSelectedCount() == 1,L"field differences support native next/previous navigation");
        const auto entries = workspace->CaptureWorkspace(); auto* restored = new CWorkspaceFrame(false); restored->RestoreWorkspace(entries); check(restored->sessions_.size() == 1 && restored->sessions_[0]->displayed_mode_ == 7 && !restored->sessions_[0]->IsBusy(),L"workspace restore retains structured modes and waits for explicit comparison"); restored->DestroyWindow();
        const auto csv_left = root / L"left.csv",csv_right = root / L"right.csv"; const std::string c = "name,value\n\"a,b\",1\n",d = "name,value\r\n\"a,b\",2\r\n"; Write(csv_left,{c.begin(),c.end()}); Write(csv_right,{d.begin(),d.end()}); workspace->NewComparisonInputs(csv_left.wstring(),csv_right.wstring(),L"",5,true); auto* csv = workspace->sessions_.back(); check(Wait(csv) && csv->advanced_.structured_->different == 1 && csv->advanced_.Cell(0,0) == L"Row 2, column 2" && ReadDisk(csv_left) == std::vector<std::uint8_t>(c.begin(),c.end()),L"native CSV comparison respects quoted fields/logical records and preserves source bytes");
        workspace->DestroyWindow(); AfxGetApp()->m_pMainWnd = nullptr; return failures;
    }
