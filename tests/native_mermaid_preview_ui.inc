    static int RunMermaidPreview(const std::filesystem::path& root,const std::filesystem::path& screenshots = {}) {
        using namespace simple_editor::core;
        int failures = 0; const auto check = [&](bool ok,const wchar_t* name) { std::wcout << (ok ? L"PASS: " : L"FAIL: ") << name << L'\n'; if (!ok) ++failures; };
        const std::wstring graph_text = L"flowchart TD\nBoot[\"啟動與初始化\"] --> Load[\"讀取設定並驗證\"]\nLoad -->|失敗| Stop[\"顯示錯誤並停止\"]\nLoad -->|成功| Wait{\"等待使用者輸入\"}\nWait -->|重新嘗試| Wait\nWait -->|有效輸入| Run[\"執行文件處理\"]\nRun --> Output[\"產生預覽結果\"]\nOutput --> Done(\"完成\")\nDone -->|繼續| Wait\nRun -->|取消| Wait\nRun -->|錯誤| Stop\n";
        std::atomic_bool cancel{false}; Flowchart graph;
        check(ParseFlowchart(graph_text,graph,cancel) && graph.nodes.size() == 7 && graph.edges.size() == 10,L"parse Unicode node labels, branching arrows, repeated references and cycles");
        check(graph.nodes.size() > 3 && graph.nodes[3].shape == FlowShape::Diamond && graph.nodes.back().shape == FlowShape::Rounded,L"retain decision and rounded node shapes");
        for (const auto* direction : {L"TD",L"TB",L"BT",L"LR",L"RL"}) check(ParseFlowchart(std::wstring(L"graph ") + direction + L"; A((Start)) -->|go| B[End]; %% comment\nB --> C;",graph,cancel),L"parse supported graph direction, circle, chain, semicolon and comments");
        check(ParseFlowchart(L"flowchart TD\nA[\"first<br/>second\"] --> B\nA[\"last label\"]",graph,cancel) && graph.nodes[0].label == L"last label",L"later explicit node label updates the same node");
        check(ParseFlowchart(L"flowchart TD\nA -->|first| B\nA -->|second| B",graph,cancel) && graph.edges.size() == 2 && graph.edges[0].label == L"first" && graph.edges[1].label == L"second",L"parallel arrows retain both independent labels");
        for (const auto* invalid : {L"sequenceDiagram\nA->>B:hello",L"flowchart TD\nsubgraph Group\nA --> B\nend",L"flowchart TD\nA --> B\nclick A \"https://example.invalid\"",L"flowchart TD\nA[\"<img src=x>\"]",L"flowchart TD\nA -->|missing",L"flowchart TD\nA ==> B",L"flowchart TD\nA:::red",L"flowchart TD\nA[\"unterminated]",L"flowchart TD\nA([stadium])",L"flowchart TD\nA[(database)]",L"flowchart TD\nA[/parallelogram/]",L"flowchart TD\nA{{hexagon}}",L"%%{init: {}}%%\nflowchart TD\nA --> B"})
            check(!ParseFlowchart(invalid,graph,cancel) && graph.nodes.empty(),L"unsupported or malformed diagrams fail closed without partial graphs");
        std::wstring nodes = L"flowchart TD\n"; for (int i = 0; i < 65; ++i) nodes += L"N" + std::to_wstring(i) + L"\n";
        check(!ParseFlowchart(nodes,graph,cancel),L"node bound rejects excessive graphs without trimming the source");
        std::wstring edges = L"flowchart TD\n"; for (int i = 0; i < 97; ++i) edges += L"A --> B\n";
        check(!ParseFlowchart(edges,graph,cancel) && !ParseFlowchart(std::wstring(16385,L'x'),graph,cancel),L"edge and block bounds reject excessive input");
        const auto render = simple_editor::ui::RenderFlowchartPicture;
        const auto picture = render(graph_text,true,24,10000,cancel);
        check(picture.find("\\pict\\emfblip") != std::string::npos && picture.size() < 524500,L"native GDI generates a bounded in-memory vector picture");
        const auto handles = GetGuiResources(GetCurrentProcess(),GR_GDIOBJECTS);
        for (int i = 0; i < 24; ++i) render(graph_text,(i % 2) != 0,24 + i % 4,6000,cancel);
        check(GetGuiResources(GetCurrentProcess(),GR_GDIOBJECTS) == handles,L"repeated worker rendering releases GDI fonts, brushes, pens, DCs and metafiles");
        const auto document = L"# Flowchart preview\n\n```mermaid\n" + graph_text + L"```\n\n## After diagram\nThe original source remains editable.\n";
        const auto rendered = RenderMarkdownPreview(document,true,24,10000,L"LIMIT",cancel,render,L"UNSUPPORTED");
        check(std::count(rendered.scroll_text.begin(),rendered.scroll_text.end(),L'\xFFFC') == 1 && rendered.rtf.find("flowchart TD") == std::string::npos,L"Markdown embeds one picture instead of the Mermaid source code");
        check(rendered.anchors.size() == rendered.source_lines && rendered.scroll_text.find(L"Afterdiagram") != std::wstring::npos,L"picture placeholder preserves source anchors and following prose");
        const auto fallback = RenderMarkdownPreview(L"```mermaid\nsequenceDiagram\nA->>B:hello\n```\n",false,20,6000,L"",cancel,render,L"UNSUPPORTED");
        check(fallback.rtf.find("UNSUPPORTED") != std::string::npos && fallback.scroll_text.find(L"sequenceDiagram") != std::wstring::npos && fallback.scroll_text.find(L'\xFFFC') == std::wstring::npos,L"unsupported Mermaid displays an explicit notice and original code");
        std::wstring repeated; for (int i = 0; i < 9; ++i) repeated += L"```mermaid\nflowchart TD\nA --> B\n```\n";
        const auto bounded = RenderMarkdownPreview(repeated,true,20,6000,L"",cancel,render,L"UNSUPPORTED");
        check(std::count(bounded.scroll_text.begin(),bounded.scroll_text.end(),L'\xFFFC') == 8 && bounded.rtf.find("UNSUPPORTED") != std::string::npos,L"document picture count is bounded with visible fallback");
        cancel = true; check(render(graph_text,true,24,10000,cancel).empty() && RenderMarkdownPreview(document,true,24,10000,L"",cancel,render).rtf.empty(),L"cancelled graphs cannot publish a stale picture"); cancel = false;
        std::wstring error; check(simple_editor::ui::InitializeLocalization(std::filesystem::current_path() / L"src/res",L"tw",&error),L"load catalogs for native diagram preview");
        auto* workspace = new CWorkspaceFrame(false); AfxGetApp()->m_pMainWnd = workspace; workspace->preferences_path_ = root / L"mermaid-synthetic.ini";
        workspace->SetWindowPos(nullptr,0,0,1500,1100,SWP_NOZORDER | SWP_NOACTIVATE); workspace->ShowWindow(SW_SHOWNOACTIVATE);
        const auto file = root / L"flowchart-synthetic.md"; const auto bytes = CCodeEditor::ToUtf8(document); Write(file,{bytes.begin(),bytes.end()});
        workspace->OpenPath(file.wstring()); auto* frame = workspace->sessions_.back();
        const auto wait = [&] { const auto deadline = GetTickCount64() + 15000; do { MSG message{}; while (PeekMessageW(&message,nullptr,0,0,PM_REMOVE)) { TranslateMessage(&message); DispatchMessageW(&message); } frame->OnTimer(1); if (frame->markdown_preview_.Current(frame->text_,frame->revision_)) return true; Sleep(1); } while (GetTickCount64() < deadline); return false; };
        check(wait(),L"native worker publishes the latest diagram preview");
        auto& view = frame->markdown_preview_; auto& rich = view.rich_; auto& source = frame->text_;
        const auto objects = [&] { IRichEditOle* ole = nullptr; rich.SendMessage(EM_GETOLEINTERFACE,0,reinterpret_cast<LPARAM>(&ole)); if (!ole) return -1L; const auto count = ole->GetObjectCount(); ole->Release(); return count; };
        check(objects() == 1,L"Rich Edit actually contains the rendered picture object");
        check(!view.scroll_anchors_.empty() && view.scroll_anchors_.size() == rendered.source_lines,L"native RAWTEXT validates the picture placeholder and all following anchors");
        FINDTEXTEXW following{}; following.chrg = {0,-1}; following.lpstrText = const_cast<wchar_t*>(L"After diagram");
        const auto following_position = rich.SendMessage(EM_FINDTEXTEXW,FR_DOWN | FR_MATCHCASE,reinterpret_cast<LPARAM>(&following));
        check(view.scroll_anchors_.size() > 16 && view.scroll_anchors_[16].character == following_position,L"heading after the picture keeps its exact native source anchor");
        rich.SendMessage(WM_VSCROLL,SB_TOP); POINT top{},wheel{}; rich.SendMessage(EM_GETSCROLLPOS,0,reinterpret_cast<LPARAM>(&top));
        rich.SendMessage(WM_MOUSEWHEEL,MAKEWPARAM(0,static_cast<WORD>(-WHEEL_DELTA)),0); rich.SendMessage(EM_GETSCROLLPOS,0,reinterpret_cast<LPARAM>(&wheel));
        CRect viewport; rich.GetClientRect(viewport);
        std::wcout << L"DIAGRAM WHEEL: pixels=" << wheel.y - top.y << L" viewport=" << viewport.Height() << L'\n';
        check(wheel.y > top.y && wheel.y - top.y < viewport.Height(),L"ordinary wheel can read through a tall diagram without skipping the whole picture");
        const auto before = source.Utf8(); const auto generation = source.Generation(),revision = frame->revision_;
        check(before.find("flowchart TD") != std::string::npos && ReadDisk(file) == std::vector<std::uint8_t>(bytes.begin(),bytes.end()),L"diagram rendering retains source syntax and original disk bytes");
        source.SetSel(2,7); const auto selection = source.Call(SCI_GETSELECTIONSTART);
        source.Call(SCI_SETFIRSTVISIBLELINE,5); frame->OnTimer(1);
        check(source.Call(SCI_GETSELECTIONSTART) == selection && source.Generation() == generation && frame->revision_ == revision,L"diagram scroll synchronization does not move source selection or edit generations");
        frame->SetTabZoom(1,150); check(wait() && objects() == 1 && source.Utf8() == before,L"zoom redraws the vector diagram without replacing source buffers");
        frame->OnEditorCommand(ID_VIEW_DARK); check(wait() && objects() == 1,L"theme changes redraw the graph in the current native preview");
        frame->SetTabZoom(1,100); check(wait(),L"restore default diagram scale");
        if (!screenshots.empty()) { frame->OnEditorCommand(ID_VIEW_DARK); check(wait(),L"render dark diagram for visual inspection"); std::filesystem::create_directories(screenshots); source.Call(SCI_SETFIRSTVISIBLELINE,0); rich.SendMessage(WM_VSCROLL,SB_TOP); frame->OnTimer(1); workspace->RedrawWindow(nullptr,nullptr,RDW_INVALIDATE | RDW_ALLCHILDREN | RDW_UPDATENOW); check(ExpansionCapture(*workspace,screenshots / L"mermaid-preview.png"),L"capture synthetic native flowchart preview"); }
        source.SetSel(-1,-1); source.ReplaceSel(L"\r\nDraft\r\n",TRUE); check(wait() && source.CanUndo(),L"unsaved native changes retain Undo while rendering diagrams");
        frame->OnUndo(); check(wait() && source.Utf8() == before,L"Undo restores the source independently of the rendered picture");
        frame->ShowPage(0); check(!rich.IsWindowVisible(),L"hidden preview stops visible graph work"); frame->ShowPage(1); check(wait() && objects() == 1,L"returning to Text restores the diagram");
        const auto unsupported_file = root / L"unsupported-synthetic.md"; const std::string unsupported_text = "```mermaid\nsequenceDiagram\nA->>B:hello\n```\n";
        Write(unsupported_file,{unsupported_text.begin(),unsupported_text.end()}); workspace->OpenPath(unsupported_file.wstring()); frame = workspace->sessions_.back();
        check(wait(),L"unsupported diagram still publishes a usable native preview"); CString fallback_text; frame->markdown_preview_.rich_.GetWindowTextW(fallback_text);
        check(fallback_text.Find(L"語法不支援") >= 0 && fallback_text.Find(L"sequenceDiagram") >= 0,L"Traditional Chinese fallback notice retains the unsupported source code");
        const auto fallback_source = frame->text_.Utf8(); check(simple_editor::ui::SetUiLanguage(L"en") && wait(),L"language switching refreshes the diagram fallback presentation");
        frame->markdown_preview_.rich_.GetWindowTextW(fallback_text);
        check(fallback_text.Find(L"unsupported syntax or preview limit") >= 0 && frame->text_.Utf8() == fallback_source,L"English fallback changes only presentation and preserves the native source");
        workspace->DestroyWindow(); AfxGetApp()->m_pMainWnd = nullptr; simple_editor::ui::ShutdownLocalization(); return failures;
    }
