    static int RunPresentation(const std::filesystem::path& root,const std::filesystem::path& screenshots = {}) {
        int failures = 0; const auto check = [&](bool ok,const wchar_t* label) { std::wcout << (ok ? L"PASS: " : L"FAIL: ") << label << L'\n'; if (!ok) ++failures; };
        const auto a = root / L"align-left.txt", b = root / L"align-right.txt";
        const auto write_text = [&](const std::filesystem::path& path,const std::wstring& text) { const auto bytes = CCodeEditor::ToUtf8(text); Write(path,{bytes.begin(),bytes.end()}); };
        write_text(a,L"name=one\ncount=10\nstate=old\n甲乙丙 a\U0001F680z\n"); write_text(b,L"unrelated prefix\nname=two\ncount=11\nstate=new\n甲丁丙 a\U0001F600z\n");
        auto* frame = new CMainFrame(false); AfxGetApp()->m_pMainWnd = frame; frame->SetWindowPos(nullptr,0,0,1400,900,SWP_NOACTIVATE | SWP_NOZORDER); frame->SetComparisonPaths(a.wstring(),b.wstring(),2); frame->compare_mode_.SetCurSel(2); frame->displayed_mode_ = 2; frame->EnsureAdvanced(); auto& view = frame->advanced_; view.Configure(2);
        auto left = std::make_unique<simple_editor::core::BinaryDocument>(), right = std::make_unique<simple_editor::core::BinaryDocument>(); std::wstring error; left->Open(a.wstring(),&error); right->Open(b.wstring(),&error); view.StartText(nullptr,std::move(left),std::move(right)); frame->ShowPage(2);
        check(Wait(frame) && view.presentation_ && view.presentation_->characters.size() == view.text_rows_.size(),L"text comparison plans cached intraline spans in the background");
        view.output_.SetSel(view.output_.GetWindowTextLength(),-1); view.output_.ReplaceSel(L"USER\r\n",TRUE); CString output; view.output_.GetWindowTextW(output); const auto generation = view.output_.Generation();
        view.similar_.SetCheck(BST_CHECKED); view.OnSimilarChanged(); check(Wait(frame) && view.text_rows_.size() == 5 && view.text_rows_[0].left == -1 && view.text_rows_[1].left == 0 && view.text_rows_[1].right == 1,L"similar-line UI command realigns changed source rows");
        CString retained; view.output_.GetWindowTextW(retained); check(retained == output && view.output_.Generation() == generation && view.output_.CanUndo() && view.Dirty(),L"presentation changes preserve merged text, dirty state and native Undo");
        check(!view.presentation_->characters[1].left.empty() && !view.presentation_->characters[1].right.empty(),L"realigned text rows retain their cached changed-character spans");
        CRect overview; view.overview_.GetClientRect(overview); view.overview_.SendMessage(WM_LBUTTONDOWN,MK_LBUTTON,MAKELPARAM(overview.Width() / 2,(std::max)(0,overview.Height() - 1))); check(view.rows_.GetNextItem(-1,LVNI_SELECTED) == static_cast<int>(view.visible_.size()) - 1,L"clicking the difference overview navigates to the corresponding source row");
        view.syntax_.SetCheck(BST_UNCHECKED); view.OnFilterChanged(); frame->ShowWindow(SW_SHOWNOACTIVATE); frame->RedrawWindow(nullptr,nullptr,RDW_INVALIDATE | RDW_UPDATENOW | RDW_ALLCHILDREN); check(view.presentation_ && !view.presentation_->characters.back().left.empty(),L"intraline highlighting remains available with syntax colors disabled");
        if (!screenshots.empty()) { std::filesystem::create_directories(screenshots); CRect bounds; frame->GetWindowRect(bounds); CImage picture; picture.Create(bounds.Width(),bounds.Height(),32); const auto dc = picture.GetDC(); const BOOL rendered = ::PrintWindow(frame->GetSafeHwnd(),dc,0); picture.ReleaseDC(); check(rendered && SUCCEEDED(picture.Save((screenshots / L"unicode-intraline-overview.png").c_str())),L"capture the actual Unicode intraline/overview view"); }
        frame->ShowWindow(SW_HIDE); view.similar_.SetCheck(BST_UNCHECKED); view.OnSimilarChanged(); view.Cancel(); check(Wait(frame) && view.similar_.GetCheck() == BST_CHECKED,L"cancelled realignment restores the displayed alignment option");
        view.InvalidateInputs(); view.overview_.SendMessage(WM_LBUTTONDOWN,MK_LBUTTON,MAKELPARAM(5,5)); check(view.rows_.GetItemCount() == 0,L"invalidated paths clear the overview and cannot navigate stale rows"); frame->DestroyWindow(); AfxGetApp()->m_pMainWnd = nullptr; return failures;
    }
