    static int RunFormatTools(const std::filesystem::path& root) {
        int failures = 0; const auto check = [&](bool ok,const wchar_t* label) { std::wcout << (ok ? L"PASS: " : L"FAIL: ") << label << L'\n'; if (!ok) ++failures; };
        auto* frame = new CMainFrame(false); AfxGetApp()->m_pMainWnd = frame; const auto path = root / L"format-source.txt"; Write(path,{'A','\n','B'}); frame->OpenPath(path.wstring()); frame->ShowPage(1); frame->text_.SetSel(0,1); frame->text_.ReplaceSel(L"Draft",TRUE); CString draft; frame->text_.GetWindowTextW(draft);
        simple_editor::core::TextOutputOptions options; options.codec = {simple_editor::core::TextEncoding::Utf16Be,1201,true}; options.eol = simple_editor::core::OutputEol::Cr;
        const auto copy = root / L"converted.txt"; check(frame->StartConvertedCopy(copy.wstring(),options) && Wait(frame),L"product encoding/EOL conversion exports in a background job");
        check(ReadDisk(copy) == std::vector<std::uint8_t>({0xFE,0xFF,0,'D',0,'r',0,'a',0,'f',0,'t',0,13,0,'B'}),L"converted output uses requested endian/BOM/EOL and current unsaved text"); CString after; frame->text_.GetWindowTextW(after);
        check(after == draft && frame->text_.GetModify() && frame->text_.CanUndo() && ReadDisk(path) == std::vector<std::uint8_t>({'A',10,'B'}),L"conversion preserves the original file, native draft and Undo");
        frame->OnUndo(); frame->ShowPage(0); const auto hex = root / L"converted.hex"; check(frame->StartBinaryTool(ID_TOOL_BIN_IHEX,hex.wstring(),{},{},0x10000) && Wait(frame) && ReadDisk(hex)[0] == ':',L"product BIN export writes native Intel HEX records");
        auto* records = new CMainFrame(false); records->OpenPath(hex.wstring()); const auto recovered = root / L"recovered.bin";
        check(records->StartBinaryTool(ID_TOOL_IHEX_BIN,recovered.wstring(),{0xFF}) && Wait(records) && ReadDisk(recovered) == ReadDisk(path),L"product firmware conversion reconstructs exact BIN bytes"); records->DestroyWindow();
        saw_picker_ = false; auto timer = ::SetTimer(nullptr,0,30,PickerCancelTimer); frame->OnBinaryTool(ID_TOOL_INSPECT_BE); ::KillTimer(nullptr,timer); check(saw_picker_,L"native endian inspector opens its readable results dialog");
        saw_picker_ = false; timer = ::SetTimer(nullptr,0,30,PickerCancelTimer); const bool started = frame->StartBinaryTool(ID_TOOL_HASH,L""); const bool finished = Wait(frame); ::KillTimer(nullptr,timer); check(started && finished && saw_picker_,L"background hash/entropy result opens a native dialog"); frame->DestroyWindow();
        const auto left = root / L"merge-base.bin", right = root / L"merge-take.bin"; const std::string prefix = "abcdefghijklmnop", suffix = "1234567890abcdef"; const auto a = prefix + suffix, b = prefix + "XY" + suffix + "!";
        Write(left,{a.begin(),a.end()}); Write(right,{b.begin(),b.end()}); frame = new CMainFrame(false); AfxGetApp()->m_pMainWnd = frame; frame->OpenPath(left.wstring()); frame->StartCompare(right.wstring(),true); check(Wait(frame) && !frame->pending_differences_.empty(),L"binary merge starts from real compared input snapshots");
        std::set<std::size_t> selected; for (std::size_t i = 0; i < frame->pending_differences_.size(); ++i) selected.insert(i); const auto merged = root / L"merged-result.bin";
        check(frame->StartBinaryMerge(merged.wstring(),true,selected) && Wait(frame) && ReadDisk(merged) == ReadDisk(right),L"product range merge handles inserted and EOF bytes in a separate output");
        check(ReadDisk(left) == std::vector<std::uint8_t>(a.begin(),a.end()) && ReadDisk(right) == std::vector<std::uint8_t>(b.begin(),b.end()),L"product binary merge leaves both comparison sources unchanged");
        check(frame->StartBinaryMerge(left.wstring(),true,selected) && Wait(frame) && ReadDisk(left) == std::vector<std::uint8_t>(a.begin(),a.end()),L"product merge rejects a source as its output before replacement"); frame->DestroyWindow(); AfxGetApp()->m_pMainWnd = nullptr; return failures;
    }
