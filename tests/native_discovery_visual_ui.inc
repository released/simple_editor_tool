    static int RunDiscoveryCompletion(const std::filesystem::path& root) {
        int failures = 0; const auto check = [&](bool ok,const wchar_t* label) { std::wcout << (ok ? L"PASS: " : L"FAIL: ") << label << L'\n'; if (!ok) ++failures; };
        auto* workspace = new CWorkspaceFrame(false); AfxGetApp()->m_pMainWnd = workspace; const auto source = root / L"completion.txt",output = root / L"completion.py"; Write(source,{'a','s','y'}); workspace->OpenPath(source.wstring()); auto* file = workspace->sessions_.back(); file->ShowPage(1); file->ToggleTextClone(); check(file->StartSave(output.wstring()) && Wait(file),L"shared-view Save As adopts the new language path");
        workspace->ShowWindow(SW_SHOW); file->clone_active_ = true; file->text_clone_.SetFocus(); file->text_clone_.Call(SCI_GOTOPOS,file->text_clone_.Call(SCI_GETLENGTH)); file->StartTextCommand(ID_FEATURE_COMPLETE); const bool ready = Wait(file); char candidate[256]{}; file->text_clone_.Call(SCI_AUTOCGETCURRENTTEXT,0,reinterpret_cast<LPARAM>(candidate)); check(ready && file->text_clone_.Call(SCI_AUTOCACTIVE) && std::string(candidate) == "async",L"native completion in the second view uses the current language after Save As"); file->text_clone_.Call(SCI_AUTOCCANCEL);
        file->StartTextCommand(ID_FEATURE_COMPLETE); file->text_clone_.ReplaceSel(L"X",TRUE); check(Wait(file) && !file->text_clone_.Call(SCI_AUTOCACTIVE) && file->text_.Utf8() == "asyX",L"typing during background completion discards the stale popup and preserves the shared draft");
        workspace->DestroyWindow(); AfxGetApp()->m_pMainWnd = nullptr; return failures;
    }
    static void CALLBACK ContentPairTimer(HWND,UINT,UINT_PTR,DWORD) {
        ::EnumThreadWindows(GetCurrentThreadId(),[](HWND window,LPARAM)->BOOL { wchar_t title[100]{}; ::GetWindowTextW(window,title,100); if (std::wstring(title) == L"Read-only content pairing") ::PostMessageW(window,WM_COMMAND,IDOK,0); return TRUE; },0);
    }
