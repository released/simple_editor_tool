    static int RunMarkdownPreview(const std::filesystem::path& root,const std::filesystem::path& screenshots = {}) {
        using namespace simple_editor::core;
        int failures = 0;
        std::function<void()> diagnostic;
        const auto check = [&](bool ok,const wchar_t* name) { std::wcout << (ok ? L"PASS: " : L"FAIL: ") << name << L'\n'; if (!ok) { ++failures; if (diagnostic) diagnostic(); } };
        std::wstring error; check(simple_editor::ui::InitializeLocalization(std::filesystem::current_path() / L"src/res",L"tw",&error),L"load paired catalogs for Markdown preview");
        std::atomic_bool cancel{false};
        const auto rtf = RenderMarkdownPreview(L"# Heading\n**bold** and `code`\n{\\object test}\n| A | B |\n|---|---|\n| 1 | 2 |\n",true,20,6000,L"LIMIT",cancel);
        check(rtf.rtf.find("\\trowd") != std::string::npos && rtf.rtf.find("\\b") != std::string::npos,L"original renderer emits heading/emphasis and table layout");
        const auto paragraphs = RenderMarkdownPreview(L"soft first\nsoft second\n\nhard first  \nhard second\n",false,20,6000,L"",cancel);
        check(paragraphs.rtf.find("soft first soft second") != std::string::npos && paragraphs.rtf.find("hard first\\line hard second") != std::string::npos,L"Markdown prose uses soft wrapping while explicit hard breaks remain visible");
        check(paragraphs.source_lines == 5 && paragraphs.anchors.size() == 5 && paragraphs.scroll_text == L"softfirstsoftsecondhardfirsthardsecond",L"source anchors cover soft/hard breaks and blank lines without adding preview markers");
        const auto mixed_eol = RenderMarkdownPreview(L"# One\r\n\rTwo\nThree",false,20,6000,L"",cancel);
        check(mixed_eol.source_lines == 4 && mixed_eol.anchors.size() == 4 && mixed_eol.anchors.back().source_line == 3,L"source positions agree for CRLF, CR and LF without rewriting the input");
        const auto surrogate_limit = RenderMarkdownPreview(std::wstring(65535,L'x') + L"\U0001F680 tail",false,20,6000,L"",cancel);
        check(surrogate_limit.truncated && surrogate_limit.scroll_text.size() == 65535 && surrogate_limit.scroll_text.back() == L'x',L"bounded rendering does not split a UTF-16 surrogate pair at the source-map limit");
        check(rtf.rtf.find("{\\object test}") == std::string::npos && rtf.rtf.find("\\{\\\\object test\\}") != std::string::npos,L"input RTF controls remain escaped literal text");
        const auto limited = RenderMarkdownPreview(std::wstring(70000,L'x'),false,20,6000,L"LIMIT",cancel);
        check(limited.truncated && limited.rtf.find("LIMIT") != std::string::npos,L"preview bound is explicit without trimming the source");
        std::wstring many_lines; for (int n = 0; n < 4096; ++n) many_lines += L"x\n"; many_lines += L"last";
        check(RenderMarkdownPreview(many_lines,false,20,6000,L"LIMIT",cancel).truncated,L"line limit reports a final omitted line without a trailing newline");
        cancel = true; check(RenderMarkdownPreview(L"# Cancel",false,20,6000,L"",cancel).rtf.empty(),L"cancelled parser returns no stale presentation"); cancel = false;
        auto* workspace = new CWorkspaceFrame(false); AfxGetApp()->m_pMainWnd = workspace; workspace->preferences_path_ = root / L"markdown-synthetic.ini";
        workspace->SetWindowPos(nullptr,0,0,1400,950,SWP_NOZORDER | SWP_NOACTIVATE); workspace->ShowWindow(SW_SHOWNOACTIVATE);
        const auto file = root / L"preview # Chinese.markdown";
        const std::wstring original = L"# Markdown 預覽\n\n原始碼與預覽使用相同文件。\n\n## 功能\n\n- **粗體重點**與 *斜體*\n- `inline_code()` 與 [操作說明](guide.md)\n\n> 引用段落\n\n| 項目 | 狀態 |\n|---|---|\n| 原始碼 | 可編輯 |\n| 預覽 | 唯讀 |\n\n```c\nint value = 42;\n```\n";
        const auto utf8 = CCodeEditor::ToUtf8(original); Write(file,{utf8.begin(),utf8.end()});
        workspace->OpenPath(file.wstring()); auto* frame = workspace->sessions_.back();
        const auto wait_preview = [&](CMainFrame* target = nullptr) { if (!target) target = frame; const auto deadline = GetTickCount64() + 10000; do { MSG message{}; while (PeekMessageW(&message,nullptr,0,0,PM_REMOVE)) { TranslateMessage(&message); DispatchMessageW(&message); } target->OnTimer(1); if (target->markdown_preview_.Current(target->text_,target->revision_)) { target->OnTimer(1); if (target->markdown_preview_.Current(target->text_,target->revision_)) return true; } Sleep(1); } while (GetTickCount64() < deadline); return false; };
        const auto native_before = frame->text_.Utf8();
        const auto modified_before = frame->text_.GetModify();
        const auto generation = frame->text_.Generation(),revision = frame->revision_;
        check(frame->MarkdownPreviewActive() && wait_preview(),L"Markdown files automatically open editable source plus a live preview");
        check(frame->text_.Utf8() == native_before && frame->text_.Generation() == generation && frame->revision_ == revision,L"preview leaves the native CRLF display adapter, generation and revision unchanged");
        check(frame->text_.GetModify() == modified_before,L"preview does not dirty the original document");
        check(ReadDisk(file) == std::vector<std::uint8_t>(utf8.begin(),utf8.end()),L"viewing preview does not save or rewrite the file");
        auto& preview = frame->markdown_preview_.rich_; CString visible; preview.GetWindowTextW(visible);
        check(visible.Find(L"Markdown 預覽") >= 0 && visible.Find(L"# Markdown") < 0 && visible.Find(L"int value = 42;") >= 0,L"native preview shows rendered Unicode heading and code without fence syntax");
        CRect left,right; frame->text_.GetWindowRect(left); frame->markdown_preview_.GetWindowRect(right);
        check(left.right < right.left && right.Width() > 100,L"source stays left and preview stays right without overlapping");
        check((preview.GetStyle() & ES_READONLY) != 0,L"rendered preview is read-only");
        frame->text_.SetSel(-1,-1); frame->text_.ReplaceSel(L"\nLive update\n",TRUE);
        const auto edited = frame->text_.Utf8(); const auto edited_generation = frame->text_.Generation();
        check(wait_preview(),L"unsaved source changes update after bounded debounce"); preview.GetWindowTextW(visible);
        check(visible.Find(L"Live update") >= 0 && frame->text_.Utf8() == edited && frame->text_.Generation() == edited_generation,L"background rendering adopts only the latest unsaved source without replacing its buffer");
        frame->OnUndo(); check(frame->text_.Utf8() == native_before && wait_preview(),L"preview preserves native source Undo");
        frame->OnMarkdownPreview(); check(!frame->MarkdownPreviewActive() && !(frame->markdown_preview_.GetStyle() & WS_VISIBLE),L"Review menu hides preview without discarding source");
        frame->OnMarkdownPreview(); check(frame->MarkdownPreviewActive() && wait_preview(),L"Review menu restores preview locally");
        frame->SetTabZoom(1,150); check(wait_preview() && frame->text_.Utf8() == native_before,L"font zoom updates presentation without modifying source");
        frame->OnEditorCommand(ID_VIEW_DARK); check(wait_preview(),L"theme changes update native preview");
        frame->SetTabZoom(1,100); check(wait_preview(),L"restore readable default preview scale");
        frame->ShowPage(0); check(!(frame->markdown_preview_.GetStyle() & WS_VISIBLE),L"Hex page hides the preview");
        frame->ShowPage(1); check(wait_preview(),L"returning to Text reuses the source and preview");
        const auto original_source_top = frame->text_.Call(SCI_GETFIRSTVISIBLELINE),original_preview_top = preview.SendMessage(EM_GETFIRSTVISIBLELINE);
        std::vector<std::wstring> rows; std::vector<std::size_t> headings,bodies,table_rows,code_rows;
        for (int n = 0; n < 80; ++n) {
            const auto id = std::to_wstring(n); headings.push_back(rows.size()); rows.push_back(L"## Section " + id + L" 中文標題"); rows.push_back(L"");
            bodies.push_back(rows.size()); auto body = L"Body " + id + L" " + std::wstring(120,L'中'); for (int word = 0; word < 40; ++word) body += L" word"; rows.push_back(body + L" **bold** and `code` \U0001F680");
            rows.push_back(L"Soft continuation " + id + L" with [link](guide.md) and ![image](local.png)  "); rows.push_back(L"Hard continuation " + id); rows.push_back(L"");
            rows.push_back(L"| Name | Value |"); rows.push_back(L"|---|---|"); table_rows.push_back(rows.size()); rows.push_back(L"| Row " + id + L" | value " + id + L" |"); rows.push_back(L"");
            rows.push_back(L"```cpp"); code_rows.push_back(rows.size()); rows.push_back(L"int code_" + id + L" = " + id + L";"); rows.push_back(L"```"); rows.push_back(L"");
        }
        std::wstring scroll_source; for (const auto& row : rows) scroll_source += row + L"\n";
        const auto scroll_file = root / L"scroll-synthetic.md"; const auto scroll_utf8 = CCodeEditor::ToUtf8(scroll_source); Write(scroll_file,{scroll_utf8.begin(),scroll_utf8.end()});
        workspace->OpenPath(scroll_file.wstring()); auto* scrolling = workspace->sessions_.back(); check(wait_preview(scrolling),L"render mixed long Markdown for scroll synchronization");
        scrolling->OnEditorCommand(ID_VIEW_DARK); check(wait_preview(scrolling),L"dark content retains current scroll metadata");
        auto& view = scrolling->markdown_preview_; auto& rich = view.rich_; auto& source = scrolling->text_;
        diagnostic = [&] { const auto first = source.Call(SCI_GETFIRSTVISIBLELINE),line = source.Call(SCI_DOCLINEFROMVISIBLE,first); std::wcout << L"SCROLL: source_first=" << first << L" source_line=" << line << L" wrap=" << source.Call(SCI_WRAPCOUNT,line) << L" preview_first=" << rich.SendMessage(EM_GETFIRSTVISIBLELINE) << L" anchors=" << view.scroll_anchors_.size() << L" current=" << view.Current(source,scrolling->revision_) << L" job=" << view.job_.valid() << L'\n'; };
        check(!view.scroll_anchors_.empty() && view.scroll_anchors_.size() == rows.size() && !view.truncated_,L"native source map verifies headings, hard breaks, links, images, code and table structure");
        source.Call(SCI_SETEMPTYSELECTION,source.Call(SCI_GETLENGTH)); source.ReplaceSel(L"\r\n<!-- draft -->\r\n",TRUE); check(wait_preview(scrolling) && source.CanUndo(),L"synchronized view retains a normal unsaved native Undo action");
        const auto content = source.Utf8(); const auto scroll_generation = source.Generation(),scroll_revision = scrolling->revision_; source.Call(SCI_SETSEL,5,12); source.Call(SCI_SETXOFFSET,37);
        const auto find_rich = [&](const wchar_t* text) { FINDTEXTEXW find{}; find.chrg = {0,-1}; find.lpstrText = const_cast<wchar_t*>(text); return static_cast<LONG>(rich.SendMessage(EM_FINDTEXTEXW,FR_DOWN | FR_MATCHCASE,reinterpret_cast<LPARAM>(&find))); };
        const auto rich_line = [&](const wchar_t* text) { const auto position = find_rich(text); return position < 0 ? static_cast<LRESULT>(-1) : rich.SendMessage(EM_EXLINEFROMCHAR,0,position); };
        const auto source_line = [&] { return source.Call(SCI_DOCLINEFROMVISIBLE,source.Call(SCI_GETFIRSTVISIBLELINE)); };
        const auto source_to = [&](std::size_t line) { source.SetFocus(); source.Call(SCI_SETFIRSTVISIBLELINE,source.Call(SCI_VISIBLEFROMDOCLINE,line)); scrolling->OnTimer(1); };
        const auto preview_to = [&](const wchar_t* text,int extra = 0) { rich.SetFocus(); const auto row = rich_line(text); if (row >= 0) rich.SendMessage(EM_LINESCROLL,0,row + extra - rich.SendMessage(EM_GETFIRSTVISIBLELINE)); scrolling->OnTimer(1); };
        source_to(headings[20]);
        check(rich_line(L"Section 20") >= 0 && std::llabs(rich.SendMessage(EM_GETFIRSTVISIBLELINE) - rich_line(L"Section 20")) <= 1,L"scrolling source aligns the preview with the same heading rather than a global percentage");
        preview_to(L"Section 35"); check(std::llabs(source_line() - static_cast<LRESULT>(headings[35])) <= 1,L"scrolling preview follows the original source heading in the other direction");
        source_to(table_rows[30]); check(std::llabs(rich.SendMessage(EM_GETFIRSTVISIBLELINE) - rich_line(L"Row 30")) <= 1,L"table-row source anchors retain correct native positions after Rich Edit table delimiters");
        preview_to(L"int code_42"); check(std::llabs(source_line() - static_cast<LRESULT>(code_rows[42])) <= 1,L"rendered code navigates to its actual source line without fence-line drift");
        source.SetWrap(true); scrolling->Layout(); check(wait_preview(scrolling),L"wrapped source layout retains a current preview map");
        const auto wrapped = source.Call(SCI_WRAPCOUNT,bodies[25]); source.Call(SCI_SETFIRSTVISIBLELINE,source.Call(SCI_VISIBLEFROMDOCLINE,bodies[25]) + wrapped / 2); scrolling->OnTimer(1);
        check(wrapped > 1 && rich.SendMessage(EM_GETFIRSTVISIBLELINE) >= rich_line(L"Body 25") && rich.SendMessage(EM_GETFIRSTVISIBLELINE) < rich_line(L"Body 26"),L"wrapped source sublines stay within their matching rendered paragraph");
        preview_to(L"Body 28",2); check(source_line() == static_cast<LRESULT>(bodies[28]) && source.Call(SCI_GETFIRSTVISIBLELINE) > source.Call(SCI_VISIBLEFROMDOCLINE,bodies[28]),L"scrolling within a wrapped preview paragraph follows a source subline");
        source.SetWrap(false); scrolling->Layout(); check(wait_preview(scrolling),L"restore nonwrapping source after fractional alignment"); source.Call(SCI_SETXOFFSET,37); source_to(headings[20]);
        const auto before_wheel = source.Call(SCI_GETFIRSTVISIBLELINE),rich_before_wheel = rich.SendMessage(EM_GETFIRSTVISIBLELINE); CRect wheel_bounds; source.GetWindowRect(wheel_bounds); const auto point = wheel_bounds.CenterPoint();
        source.SendMessage(WM_MOUSEWHEEL,MAKEWPARAM(0,static_cast<WORD>(-WHEEL_DELTA)),MAKELPARAM(point.x,point.y)); scrolling->OnTimer(1);
        check(source.Call(SCI_GETFIRSTVISIBLELINE) > before_wheel && rich.SendMessage(EM_GETFIRSTVISIBLELINE) != rich_before_wheel,L"ordinary source wheel movement also scrolls the matching preview");
        preview_to(L"int code_42"); rich.GetWindowRect(wheel_bounds); const auto rich_point = wheel_bounds.CenterPoint(); const auto before_rich_wheel = source.Call(SCI_GETFIRSTVISIBLELINE),before_rich_row = rich.SendMessage(EM_GETFIRSTVISIBLELINE); rich.SetFocus();
        rich.SendMessage(WM_MOUSEWHEEL,MAKEWPARAM(0,static_cast<WORD>(-WHEEL_DELTA)),MAKELPARAM(rich_point.x,rich_point.y)); scrolling->OnTimer(1);
        if (source.Call(SCI_GETFIRSTVISIBLELINE) == before_rich_wheel) std::wcout << L"SCROLL: wheel_source_before=" << before_rich_wheel << L" rich_before=" << before_rich_row << L" rich_after=" << rich.SendMessage(EM_GETFIRSTVISIBLELINE) << L'\n';
        check(rich.SendMessage(EM_GETFIRSTVISIBLELINE) > before_rich_row && source.Call(SCI_GETFIRSTVISIBLELINE) > before_rich_wheel,L"ordinary preview wheel across blocks also scrolls the matching source");
        preview_to(L"int code_45"); const auto partial_before = rich.SendMessage(EM_GETFIRSTVISIBLELINE);
        rich.SendMessage(WM_MOUSEWHEEL,MAKEWPARAM(0,static_cast<WORD>(-WHEEL_DELTA / 2)),MAKELPARAM(rich_point.x,rich_point.y)); scrolling->OnTimer(1);
        check(rich.SendMessage(EM_GETFIRSTVISIBLELINE) == partial_before,L"partial precision-wheel deltas do not scroll early");
        rich.SendMessage(WM_MOUSEWHEEL,MAKEWPARAM(0,static_cast<WORD>(-WHEEL_DELTA / 2)),MAKELPARAM(rich_point.x,rich_point.y)); scrolling->OnTimer(1);
        check(rich.SendMessage(EM_GETFIRSTVISIBLELINE) > partial_before,L"precision-wheel deltas accumulate to one normal preview scroll step");
        const auto old_zoom = scrolling->zoom_percent_[1]; rich.SendMessage(WM_MOUSEWHEEL,MAKEWPARAM(MK_CONTROL,WHEEL_DELTA),MAKELPARAM(rich_point.x,rich_point.y));
        check(scrolling->zoom_percent_[1] == old_zoom + 10 && wait_preview(scrolling),L"Ctrl+wheel on preview uses the document's shared zoom instead of an independent Rich Edit scale");
        scrolling->SetTabZoom(1,old_zoom); check(wait_preview(scrolling),L"restore scale after preview Ctrl+wheel routing");
        source_to(headings[30]); scrolling->SetTabZoom(1,300); check(wait_preview(scrolling),L"large font zoom rebuilds scroll mapping without source edits"); source_to(headings[70]);
        check(std::llabs(rich.SendMessage(EM_GETFIRSTVISIBLELINE) - rich_line(L"Section 70")) <= 1,L"tall rendered documents use native line positions beyond 16-bit pixel scroll offsets");
        scrolling->SetTabZoom(1,110); check(wait_preview(scrolling),L"restore preview scale after tall-document synchronization");
        SCROLLINFO source_scroll{sizeof(source_scroll),SIF_RANGE | SIF_PAGE}; source.GetScrollInfo(SB_VERT,&source_scroll); const auto source_bottom = (std::max)(0,source_scroll.nMax - static_cast<int>(source_scroll.nPage) + 1);
        source_to(source_bottom); RECT end_bounds{}; POINTL end_point{-1,-1}; rich.SendMessage(EM_GETRECT,0,reinterpret_cast<LPARAM>(&end_bounds)); rich.SendMessage(EM_POSFROMCHAR,reinterpret_cast<WPARAM>(&end_point),find_rich(L"<!-- draft -->"));
        check(end_point.y >= end_bounds.top && end_point.y < end_bounds.bottom,L"source end makes the complete preview's final text visible");
        source_to(0); check(rich.SendMessage(EM_GETFIRSTVISIBLELINE) == 0,L"source start restores the preview start");
        rich.SendMessage(WM_VSCROLL,SB_BOTTOM); scrolling->OnTimer(1); check(source.Call(SCI_GETFIRSTVISIBLELINE) == source_bottom,L"preview end aligns the source end without caret navigation");
        source_to(headings[20]); const auto stable_source = source.Call(SCI_GETFIRSTVISIBLELINE),stable_rich = rich.SendMessage(EM_GETFIRSTVISIBLELINE);
        for (int tick = 0; tick < 12; ++tick) scrolling->OnTimer(1);
        check(source.Call(SCI_GETFIRSTVISIBLELINE) == stable_source && rich.SendMessage(EM_GETFIRSTVISIBLELINE) == stable_rich && !view.job_.valid(),L"idle synchronization neither feeds back nor launches another renderer");
        check(source.Utf8() == content && source.Generation() == scroll_generation && scrolling->revision_ == scroll_revision && source.Call(SCI_GETANCHOR) == 5 && source.Call(SCI_GETCURRENTPOS) == 12 && source.CanUndo() && source.Call(SCI_GETXOFFSET) == 37,L"all scrolling and zoom retain source content, versions, caret, selection, horizontal position and Undo");
        check(ReadDisk(scroll_file) == std::vector<std::uint8_t>(scroll_utf8.begin(),scroll_utf8.end()),L"paired scrolling never implicitly saves the source draft");
        source.SetSel(0,0); source.ReplaceSel(L"<!-- added -->\r\n\r\n",TRUE); const auto stale_top = source.Call(SCI_GETFIRSTVISIBLELINE); rich.SendMessage(EM_LINESCROLL,0,20); view.SynchronizeScroll(source,scrolling->revision_);
        check(!view.Current(source,scrolling->revision_) && source.Call(SCI_GETFIRSTVISIBLELINE) == stale_top,L"stale preview maps cannot scroll an edited source before re-rendering");
        check(wait_preview(scrolling),L"edited Markdown publishes a version-matched replacement scroll map"); source.Undo(); check(wait_preview(scrolling) && source.Utf8() == content,L"native Undo restores source and refreshed scroll mapping");
        source_to(headings[20]); const auto tab_source = source.Call(SCI_GETFIRSTVISIBLELINE),tab_preview = rich.SendMessage(EM_GETFIRSTVISIBLELINE);
        if (!screenshots.empty()) { std::filesystem::create_directories(screenshots); source.Call(SCI_SETXOFFSET,0); check(ExpansionCapture(*workspace,screenshots / L"markdown-preview.png"),L"capture actual native Markdown panes aligned at the same section"); }
        workspace->ActivateSession(0); check(wait_preview() && frame->text_.Utf8() == native_before && frame->text_.Call(SCI_GETFIRSTVISIBLELINE) == original_source_top && preview.SendMessage(EM_GETFIRSTVISIBLELINE) == original_preview_top,L"another Markdown tab retains its own source, viewport and preview position");
        workspace->ActivateSession(1); check(wait_preview(scrolling) && source.Call(SCI_GETFIRSTVISIBLELINE) == tab_source && rich.SendMessage(EM_GETFIRSTVISIBLELINE) == tab_preview,L"returning to a Markdown tab retains its independent synchronized viewport");
        std::wstring oversized; for (int n = 0; n < 5000; ++n) oversized += L"limit line " + std::to_wstring(n) + L"\n";
        const auto limited_file = root / L"limited-scroll.md"; const auto oversized_utf8 = CCodeEditor::ToUtf8(oversized); Write(limited_file,{oversized_utf8.begin(),oversized_utf8.end()}); workspace->OpenPath(limited_file.wstring()); auto* bounded = workspace->sessions_.back();
        check(wait_preview(bounded) && bounded->markdown_preview_.truncated_,L"truncated long-source preview retains an explicit bounded scroll map");
        bounded->text_.Call(SCI_SETFIRSTVISIBLELINE,4900); bounded->OnTimer(1); const auto tail = bounded->text_.Call(SCI_GETFIRSTVISIBLELINE);
        diagnostic = [&] { std::wcout << L"SCROLL: tail_initial=" << tail << L" tail_now=" << bounded->text_.Call(SCI_GETFIRSTVISIBLELINE) << L" source_line=" << bounded->text_.Call(SCI_DOCLINEFROMVISIBLE,bounded->text_.Call(SCI_GETFIRSTVISIBLELINE)) << L" covered=" << bounded->markdown_preview_.source_lines_ << L" rich_first=" << bounded->markdown_preview_.rich_.SendMessage(EM_GETFIRSTVISIBLELINE) << L" anchors=" << bounded->markdown_preview_.scroll_anchors_.size() << L" job=" << bounded->markdown_preview_.job_.valid() << L" current=" << bounded->markdown_preview_.Current(bounded->text_,bounded->revision_) << L'\n'; };
        for (int tick = 0; tick < 8; ++tick) { bounded->markdown_preview_.rich_.SendMessage(WM_VSCROLL,SB_LINEDOWN); bounded->OnTimer(1); }
        check(tail >= 4900 && bounded->text_.Call(SCI_GETFIRSTVISIBLELINE) == tail && !bounded->markdown_preview_.job_.valid(),L"scrolling beyond the preview limit clamps only the preview and never pulls source back on idle/bottom wheel ticks");
        bounded->markdown_preview_.rich_.SendMessage(WM_VSCROLL,SB_PAGEUP); bounded->OnTimer(1);
        check(bounded->text_.Call(SCI_DOCLINEFROMVISIBLE,bounded->text_.Call(SCI_GETFIRSTVISIBLELINE)) < static_cast<LRESULT>(bounded->markdown_preview_.source_lines_),L"scrolling upward from the bounded preview end returns to represented source lines");
        workspace->DestroyWindow(); AfxGetApp()->m_pMainWnd = nullptr; simple_editor::ui::ShutdownLocalization();
