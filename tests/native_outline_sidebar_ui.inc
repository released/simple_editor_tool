        const auto bytes = first->text_.Utf8(); const auto generation = first->text_.Generation(); const auto revision = first->revision_; const auto disk = ReadDisk(a); auto& panel = first->function_sidebar_; panel.list_.SetItemState(1,LVIS_SELECTED | LVIS_FOCUSED,LVIS_SELECTED | LVIS_FOCUSED); NMHDR activate{}; LRESULT result = 0; panel.OnActivate(&activate,&result);
        check(first->text_.Call(SCI_LINEFROMPOSITION,first->text_.Call(SCI_GETCURRENTPOS)) == 3 && first->text_.Utf8() == bytes && first->text_.Generation() == generation && first->revision_ == revision && ReadDisk(a) == disk,L"single-click navigation reaches the original function line without editing or saving");
        workspace->OpenPath(header.wstring()); auto* headers = workspace->sessions_.back(); check(wait_outline(headers) && visible(headers->function_sidebar_) && headers->text_.SyntaxName() == "cpp" && headers->function_sidebar_.entries_.size() == 3 && has(headers,L"start"),L"C++ headers show constructors and declarations even without function bodies");
        workspace->OpenPath(py.wstring()); auto* python = workspace->sessions_.back(); check(wait_outline(python) && has(python,L"python_first") && !has(python,L"second()") && !visible(*first),L"another programming document owns its independent parser and function entries");
        workspace->ActivateSession(0); check(wait_outline(first) && has(first,L"second") && !has(first,L"python_first") && first->text_.Utf8() == bytes,L"switching back restores the current document's function list and source buffer");
        first->text_.SetSel(0,0); first->text_.ReplaceSel(L"// draft\r\n",TRUE); const auto edited_position = first->text_.Call(SCI_GETCURRENTPOS); panel.OnActivate(&activate,&result); check(!panel.ready_ && !panel.list_.IsWindowEnabled() && first->text_.Call(SCI_GETCURRENTPOS) == edited_position && first->text_.CanUndo(),L"an edit immediately disables old line navigation while retaining native Undo");
        check(wait_outline(first) && panel.entries_.size() > 1 && panel.entries_[1].line == 5 && ReadDisk(a) == disk,L"debounced refresh uses unsaved text and updated source line numbers"); first->text_.Undo(); check(wait_outline(first) && panel.entries_.size() > 1 && panel.entries_[1].line == 4 && first->text_.Utf8() == bytes,L"Undo refreshes the outline against the restored native document");
        panel.RefreshNow(); first->TickFunctionSidebar(); check(panel.job_.valid(),L"sidebar analysis uses an independent background job"); first->text_.SetWindowTextW(L"int replacement() { return 3; }\n"); check(wait_outline(first) && panel.entries_.size() == 1 && has(first,L"replacement") && !has(first,L"second"),L"a changed generation rejects earlier worker results before publishing navigation");
        first->text_.SetWindowTextW(CCodeEditor::FromUtf8(bytes).c_str()); check(wait_outline(first),L"restore a valid source before clone and zoom checks"); first->ToggleTextClone(); check(wait_outline(first),L"shared-view creation retains or refreshes a current function model"); first->text_clone_.SetFocus(); first->clone_active_ = true; panel.list_.SetItemState(1,LVIS_SELECTED | LVIS_FOCUSED,LVIS_SELECTED | LVIS_FOCUSED); panel.OnActivate(&activate,&result); check(first->text_clone_.Call(SCI_LINEFROMPOSITION,first->text_clone_.Call(SCI_GETCURRENTPOS)) == 3 && first->text_clone_.Utf8() == first->text_.Utf8(),L"sidebar navigation targets the active shared Text view");
        first->text_clone_.SetSel(0,0); first->text_clone_.ReplaceSel(L"// clone edit\r\n",TRUE); check(!panel.ready_ && wait_outline(first) && panel.entries_.size() > 1 && panel.entries_[1].line == 5,L"edits in a shared view update the one document outline"); first->text_clone_.Undo(); check(wait_outline(first) && first->text_.Utf8() == bytes,L"shared-view Undo restores the original functions and native text");
        panel.list_.SetItemState(0,LVIS_SELECTED | LVIS_FOCUSED,LVIS_SELECTED | LVIS_FOCUSED); NMLVKEYDOWN key{}; key.wVKey = VK_RETURN; panel.OnKey(&key.hdr,&result); check(first->text_clone_.Call(SCI_LINEFROMPOSITION,first->text_clone_.Call(SCI_GETCURRENTPOS)) == 1,L"Enter activates the selected function in the active shared view");
        const auto zoom_generation = first->text_.Generation(); first->SetTabZoom(1,150); first->function_splitter_.move(CPoint(first->page_rect_.left + 340,first->page_rect_.top)); first->text_.GetWindowRect(text_rect); first->function_sidebar_.GetWindowRect(list_rect); check(first->text_.Generation() == zoom_generation && list_rect.right < text_rect.left && first->function_sidebar_width_ == 340,L"zoom and a draggable divider preserve document state and editor geometry");
        const auto saved_path = root / L"renamed.hpp"; check(first->StartSave(saved_path.wstring()) && Wait(first) && wait_outline(first) && first->function_sidebar_.path_ == saved_path.wstring() && ReadDisk(a) == disk,L"Save As refreshes the sidebar source identity and preserves the original file");
