    static int RunComparePage(const std::filesystem::path& root,const std::filesystem::path& screenshot = {}) {
        using namespace simple_editor::core;
        int failures = 0;
        const auto check = [&](bool ok,const wchar_t* label) { std::wcout << (ok ? L"PASS: " : L"FAIL: ") << label << L'\n'; if (!ok) ++failures; };
        const auto a = root / L"left.cpp",b = root / L"right.cpp",c = root / L"replacement.cpp",recent = root / L"closed.cpp";
        const auto write = [&](const auto& path,const char* text) { const std::string value(text); Write(path,{value.begin(),value.end()}); };
        write(a,"int alpha() { return 1; }\n"); write(b,"int alpha() { return 2; }\n"); write(c,"int alpha() { return 3; }\n"); write(recent,"int closed() { return 0; }\n");
        const auto value = [](CWnd& control) { CString text; control.GetWindowTextW(text); return std::wstring(text.GetString()); };
        const auto contains = [](CComboBox& box,const std::wstring& path) { return box.FindStringExact(-1,path.c_str()) != CB_ERR; };
        const auto above = [](HWND front,HWND back) { if (!front || !back) return false; for (auto window = ::GetTopWindow(::GetParent(front));window;window = ::GetWindow(window,GW_HWNDNEXT)) { if (window == front) return true; if (window == back) return false; } return false; };
        auto* workspace = new CWorkspaceFrame(false); AfxGetApp()->m_pMainWnd = workspace;
        workspace->preferences_path_ = root / L"synthetic.ini";
        workspace->SetWindowPos(nullptr,0,0,1360,940,SWP_NOZORDER | SWP_NOACTIVATE); workspace->ShowWindow(SW_SHOWNOACTIVATE);
        workspace->OpenPath(recent.wstring()); check(workspace->CloseSession(workspace->sessions_.back()),L"close a clean file while retaining its recent-file record");
        workspace->OpenPath(a.wstring()); auto* editor = workspace->sessions_.back();
        check(above(editor->function_sidebar_.GetSafeHwnd(),editor->tabs_.GetSafeHwnd()),L"a lazily created function sidebar paints above the tab background");
        editor->ToggleTextClone(); check(editor->dual_view_ && above(editor->text_clone_.GetSafeHwnd(),editor->tabs_.GetSafeHwnd()),L"a newly created shared Text view paints above the tab background"); editor->ToggleTextClone();
        editor->text_.SetSel(0,0); editor->text_.ReplaceSel(L"// unsaved draft\r\n",TRUE);
        const auto draft = editor->text_.Utf8(); const auto generation = editor->text_.Generation(); const auto original_disk = ReadDisk(a);
        editor->ShowPage(2);
        check(editor->displayed_mode_ == 2 && editor->compare_mode_.GetCurSel() == 2 && value(editor->compare_left_path_) == a.wstring(),L"entering Compare defaults to two-way text and seeds the current file on the left");
        check(contains(editor->compare_left_path_,recent.wstring()) && contains(editor->compare_right_path_,recent.wstring()),L"both dropdowns include previously opened files after their document tab is closed");
        SetPathComboText(editor->compare_right_path_,L"draft path with spaces "); editor->compare_right_path_.SetEditSel(3,8);
        editor->SendMessage(WM_COMMAND,MAKEWPARAM(IDC_COMPARE_RIGHT_PATH,CBN_DROPDOWN),reinterpret_cast<LPARAM>(editor->compare_right_path_.GetSafeHwnd()));
        check(value(editor->compare_right_path_) == L"draft path with spaces " && editor->compare_right_path_.GetEditSel() == MAKELONG(3,8),L"opening history preserves the exact current path and edit selection");
        editor->compare_right_path_.ShowDropDown(TRUE); CRect popup,field; editor->compare_right_path_.GetDroppedControlRect(popup); editor->compare_right_path_.GetWindowRect(field);
        check(editor->compare_right_path_.GetDroppedState() && popup.Height() > field.Height(),L"the native path combobox displays an expandable history list"); editor->compare_right_path_.ShowDropDown(FALSE);
        CRect right_field; editor->compare_right_path_.GetWindowRect(right_field); CPoint drop_point = right_field.CenterPoint(); workspace->ScreenToClient(&drop_point);
        auto dropped = MakeDrop({b.wstring()}); auto* info = static_cast<DROPFILES*>(GlobalLock(dropped)); info->pt = drop_point; info->fNC = FALSE; GlobalUnlock(dropped);
        workspace->SendMessage(WM_DROPFILES,reinterpret_cast<WPARAM>(dropped));
        check(workspace->sessions_.size() == 1 && value(editor->compare_left_path_) == a.wstring() && value(editor->compare_right_path_) == b.wstring(),L"a workspace-level file drop onto the right path assigns only the right input");
        check(editor->text_.Utf8() == draft && editor->text_.Generation() == generation && editor->text_.CanUndo() && ReadDisk(a) == original_disk,L"comparison input drops preserve the existing draft, native Undo and original disk file");
        editor->OnCompareRun(); auto* compare = workspace->sessions_.back();
        check(workspace->sessions_.size() == 2 && compare != editor && Wait(compare) && compare->advanced_.model_ && !compare->advanced_.stale_,L"Compare creates a ready two-way text session while retaining the source editor");
        auto& advanced = compare->advanced_;
        check(value(compare->compare_left_path_) == a.wstring() && value(compare->compare_right_path_) == b.wstring() && advanced.source_left_.Utf8().find("unsaved draft") != std::string::npos,L"the new comparison uses the selected paths and the open editor's unsaved snapshot");
        check((workspace->sessions_tab_.GetStyle() & WS_CLIPSIBLINGS) != 0,L"workspace tabs clip sibling content during background painting");
        check((compare->tabs_.GetStyle() & WS_CLIPSIBLINGS) != 0,L"page tabs clip sibling content during background painting");
        check(above(compare->GetSafeHwnd(),workspace->sessions_tab_.GetSafeHwnd()),L"the active session paints above the workspace tab background");
        check(above(advanced.GetSafeHwnd(),compare->tabs_.GetSafeHwnd()),L"the comparison surface paints above the page tab background");
        advanced.source_right_.ValidateRect(nullptr); advanced.output_.ValidateRect(nullptr); advanced.Layout();
        check(advanced.source_right_.GetUpdateRect(nullptr,FALSE),L"result layout invalidates visible native source children without requiring a tab switch");
        advanced.RedrawWindow(nullptr,nullptr,RDW_UPDATENOW | RDW_ALLCHILDREN);
        CRect source_rect,rows_rect; advanced.source_right_.GetWindowRect(source_rect); advanced.rows_.GetWindowRect(rows_rect);
        check(advanced.source_right_.IsWindowVisible() && source_rect.Height() > 0 && source_rect.left >= rows_rect.right && !advanced.source_right_.GetUpdateRect(nullptr,FALSE),L"the first comparison paints complete, non-overlapping source and middle line panes");
        if (!screenshot.empty()) check(ExpansionCapture(*workspace,screenshot),L"capture the completed comparison before switching document tabs");
        const auto drop_ole = [&](CCodeEditor& target,const std::wstring& path) {
            CRect bounds; target.GetWindowRect(bounds); const auto point = bounds.CenterPoint(); POINTL location{point.x,point.y};
            auto* data = new TestDropData(std::vector<std::wstring>{path}); DWORD effect = DROPEFFECT_COPY;
            if (target.drop_target_) { target.drop_target_->DragEnter(data,0,location,&effect); target.drop_target_->Drop(data,0,location,&effect); } else effect = DROPEFFECT_NONE;
            data->Release(); return effect;
        };
        const auto output = advanced.RawOutputText();
        check(drop_ole(advanced.source_right_,c.wstring()) == DROPEFFECT_COPY && value(compare->compare_right_path_) == c.wstring() && value(compare->compare_left_path_) == a.wstring() && workspace->sessions_.size() == 2,L"OLE drops on the read-only right source retain the real drop position and update only the right path");
        check(advanced.stale_ && advanced.RawOutputText() == output && editor->text_.Utf8() == draft && editor->text_.CanUndo(),L"changing a dropped input invalidates old results while retaining merge output and source Undo");
        compare->OnCompareRun(); const auto busy_right = value(compare->compare_right_path_);
        drop_ole(advanced.source_right_,b.wstring()); check(value(compare->compare_right_path_) == busy_right && Wait(compare),L"dropping during a comparison cannot replace an input used by the active worker");
        check(drop_ole(advanced.source_left_,b.wstring()) == DROPEFFECT_COPY && value(compare->compare_left_path_) == b.wstring() && value(compare->compare_right_path_) == c.wstring(),L"OLE drops on the left source independently select the left input");
        dropped = MakeDrop({a.wstring()}); info = static_cast<DROPFILES*>(GlobalLock(dropped)); info->pt = {6,6}; info->fNC = FALSE; GlobalUnlock(dropped);
        advanced.source_right_.SendMessage(WM_DROPFILES,reinterpret_cast<WPARAM>(dropped));
        check(value(compare->compare_right_path_) == a.wstring() && value(compare->compare_left_path_) == b.wstring(),L"legacy child-window file drops translate client coordinates before forwarding");
        const auto left_before = value(compare->compare_left_path_); const auto right_before = value(compare->compare_right_path_);
        compare->compare_right_path_.GetWindowRect(right_field); drop_point = right_field.CenterPoint(); compare->ScreenToClient(&drop_point);
        dropped = MakeDrop({(root / L"missing.cpp").wstring()}); info = static_cast<DROPFILES*>(GlobalLock(dropped)); info->pt = drop_point; info->fNC = FALSE; GlobalUnlock(dropped); compare->SendMessage(WM_DROPFILES,reinterpret_cast<WPARAM>(dropped));
        check(value(compare->compare_left_path_) == left_before && value(compare->compare_right_path_) == right_before && workspace->sessions_.size() == 2,L"an unreadable dropped file preserves both selected inputs and all sessions");
        workspace->NewComparison(); auto* defaults = workspace->sessions_.back(); check(defaults->displayed_mode_ == 2 && defaults->compare_mode_.GetCurSel() == 2,L"the main Compare command also defaults to two-way text");
        workspace->NewComparison(a.wstring(),false); check(workspace->sessions_.back()->displayed_mode_ == 1,L"explicit equal-address binary comparison remains available");
        workspace->NewComparison(a.wstring(),true); check(workspace->sessions_.back()->displayed_mode_ == 0,L"explicit insertion-aware binary comparison remains available");
        workspace->NewComparisonInputs(root.wstring(),root.wstring(),c.wstring(),4);
        auto* folders = workspace->sessions_.back();
        check(!contains(folders->compare_left_path_,c.wstring()) && value(folders->compare_base_path_) == c.wstring(),L"folder history excludes an inactive file Base while preserving its saved value");
        workspace->OpenPath(c.wstring()); auto* closed = workspace->sessions_.back(); check(workspace->CloseSession(closed),L"close a comparison-history file without erasing its record");
        workspace->ActivateSession(1); compare->OnComparePathsDropdown(); check(contains(compare->compare_right_path_,c.wstring()) && value(compare->compare_right_path_) == right_before,L"history refresh retains closed comparison paths and preserves the current selection");
        workspace->StartPreferenceWrite(); const auto deadline = GetTickCount64() + 15000;
        do { workspace->TickPreferences(); Sleep(1); } while ((workspace->preferences_dirty_ || workspace->preferences_io_.valid()) && GetTickCount64() < deadline);
        AppPreferences saved; std::wstring error; check(LoadPreferences(workspace->preferences_path_,&saved,&error) && std::find(saved.recent.begin(),saved.recent.end(),recent.wstring()) != saved.recent.end() && std::find(saved.recent.begin(),saved.recent.end(),c.wstring()) != saved.recent.end(),L"comparison/open-file history persists through the existing portable preference writer");
        check(editor->text_.Utf8() == draft && editor->text_.CanUndo() && ReadDisk(a) == original_disk,L"all path, comparison, painting and drag/drop operations retain source drafts and disk bytes");
        for (auto* frame : workspace->sessions_) { frame->text_dirty_ = false; frame->text_.SetModify(FALSE); frame->document_.Close(); frame->advanced_.dirty_ = false; }
        workspace->DestroyWindow(); AfxGetApp()->m_pMainWnd = nullptr; return failures;
    }
