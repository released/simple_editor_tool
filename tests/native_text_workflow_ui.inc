    static int RunTextWorkflow(const std::filesystem::path& root,const std::filesystem::path& screenshots = {}) {
        using namespace simple_editor::core;
        int failures = 0;
        const auto check = [&](bool ok,const wchar_t* label) { std::wcout << (ok ? L"PASS: " : L"FAIL: ") << label << L'\n'; if (!ok) ++failures; };
        auto* workspace = new CWorkspaceFrame(false); AfxGetApp()->m_pMainWnd = workspace;
        check(!workspace->CloseSession(nullptr),L"delayed close rejects a missing session before reading its state");
        workspace->SetWindowPos(nullptr,0,0,1440,920,SWP_NOACTIVATE | SWP_NOZORDER);
        const auto a_path = root / L"guide.md",b_path = root / L"second.txt",binary = root / L"data.bin";
        Write(a_path,{'c','a','t','\n'}); Write(b_path,{'c','a','t','\n'}); Write(binary,{0,255,0,1});
        check(workspace->OpenPath(a_path.wstring()),L"open Markdown source"); auto* a = workspace->sessions_.back();
        check(a->active_tab_ == 1 && a->text_editable_,L"new text file opens on Text tab");
        check(a->text_.Call(SCI_STYLEGETBACK,STYLE_DEFAULT) == RGB(63,63,63),L"default content background is exactly #3F3F3F");
        const auto put = [](CMainFrame* frame,const wchar_t* text) { frame->text_.SetSel(0,-1); frame->text_.ReplaceSel(text,TRUE); frame->text_.Call(SCI_COLOURISE,0,-1); };
        put(a,L"# Heading\r\nplain **bold** and *emphasis*\r\n[link](https://example.test)\r\n`inline`\r\n```\r\ncode block\r\n```\r\n- list\r\n> quote\r\n");
        const auto generation = a->text_.Generation(); const auto draft = a->text_.Utf8();
        const auto style = [&](const char* text) { return static_cast<int>(a->text_.Call(SCI_GETSTYLEAT,draft.find(text))); };
        const auto heading = style("Heading"),strong = style("bold"),em = style("emphasis"),link = style("link"),code = style("inline"),block = style("code block");
        std::wcout << L"Markdown styles: " << heading << L',' << strong << L',' << em << L',' << link << L',' << code << L',' << block << L'\n';
        check(heading == 6 && strong == 2 && em == 4 && link == 18 && code == 19 && block == 20,L"Markdown lexer recognizes heading, bold, emphasis, link, inline and fenced code");
        check(a->text_.Call(SCI_STYLEGETFORE,heading) != a->text_.Call(SCI_STYLEGETFORE,0) && a->text_.Call(SCI_STYLEGETFORE,link) != a->text_.Call(SCI_STYLEGETFORE,strong) && a->text_.Call(SCI_STYLEGETFORE,code) != a->text_.Call(SCI_STYLEGETFORE,em),L"Markdown elements use distinct foreground colors");
        check(a->text_.Call(SCI_STYLEGETBOLD,heading) && a->text_.Call(SCI_STYLEGETBOLD,strong) && a->text_.Call(SCI_STYLEGETITALIC,em) && a->text_.Call(SCI_STYLEGETUNDERLINE,link),L"Markdown emphasis and link decorations are configured");
        a->text_.ConfigureLanguage(L"plain.txt"); check(!a->text_.Call(SCI_STYLEGETBOLD,6) && !a->text_.Call(SCI_STYLEGETITALIC,4) && !a->text_.Call(SCI_STYLEGETUNDERLINE,18),L"changing language clears stale Markdown decorations");
        a->text_.ConfigureLanguage(L"README.MARKDOWN"); a->text_.SetTheme(2); check(a->text_.Call(SCI_STYLEGETBACK,0) == GetSysColor(COLOR_WINDOW),L"system-contrast theme remains supported"); a->text_.SetTheme(1);
        check(a->text_.Generation() == generation && a->text_.Utf8() == draft && a->text_.CanUndo(),L"language and appearance changes preserve draft, generation and Undo");
        if (!screenshots.empty()) {
            std::filesystem::create_directories(screenshots); workspace->ShowWindow(SW_SHOWNOACTIVATE); workspace->UpdateWindow();
            CRect bounds; workspace->GetWindowRect(bounds); CImage image; image.Create(bounds.Width(),bounds.Height(),32); const auto dc = image.GetDC();
            const BOOL captured = ::PrintWindow(workspace->GetSafeHwnd(),dc,0); image.ReleaseDC();
            check(captured && SUCCEEDED(image.Save((screenshots / L"text-markdown.png").c_str())),L"capture native Markdown appearance"); workspace->ShowWindow(SW_HIDE);
        }
        a->ShowPage(0); workspace->OpenPath(a_path.wstring()); check(workspace->sessions_.size() == 1 && a->active_tab_ == 0,L"reopening an existing file retains its chosen page and draft"); a->ShowPage(1);
        check(workspace->OpenPath(b_path.wstring()),L"open second source"); auto* b = workspace->sessions_.back();
        check(workspace->OpenPath(binary.wstring()) && workspace->sessions_.back()->active_tab_ == 0,L"binary input retains Hex fallback");
        workspace->NewDocument(); auto* u = workspace->sessions_.back(); check(u->active_tab_ == 1,L"untitled document opens on Text");
        put(a,L"cat alpha\r\ncat end"); put(b,L"cat beta"); put(u,L"cat \x672A\x5B58");
        const auto original_a = a->text_.Utf8(),original_b = b->text_.Utf8(),original_u = u->text_.Utf8();
        const auto wait = [&]() { const auto stop = GetTickCount64() + 10000; while (workspace->open_search_io_.valid() && GetTickCount64() < stop) { workspace->TickOpenSearch(); MSG msg{}; while (::PeekMessage(&msg,nullptr,0,0,PM_REMOVE)) { ::TranslateMessage(&msg); ::DispatchMessage(&msg); } Sleep(1); } return !workspace->open_search_io_.valid(); };
        const auto status = [&]() { CString text; workspace->scoped_search_.GetDlgItemTextW(IDC_SEARCH_STATUS,text); return std::wstring(text); };
        workspace->ActivateSession(0); a->OnFind(); auto& dialog = workspace->scoped_search_;
        check(dialog.GetSafeHwnd() && dialog.GetDlgItem(IDC_REPLACE_ONE)->IsWindowEnabled() && dialog.GetDlgItem(IDC_REPLACE_ALL)->IsWindowEnabled(),L"Ctrl+F command opens Find/Replace with both replacement actions enabled");
        auto* scope = static_cast<CComboBox*>(dialog.GetDlgItem(IDC_SEARCH_SCOPE)); check(scope->GetCount() == 2 && scope->IsWindowEnabled(),L"Find/Replace exposes current and all-open scopes");
        scope->SetCurSel(1); dialog.SendMessage(WM_COMMAND,MAKEWPARAM(IDC_SEARCH_SCOPE,CBN_SELCHANGE),reinterpret_cast<LPARAM>(scope->GetSafeHwnd())); check(!dialog.GetDlgItem(IDC_SEARCH_SELECTION)->IsWindowEnabled(),L"all-open scope disables selection-only ambiguity");
        dialog.SetDlgItemTextW(IDC_SEARCH_TEXT,L"cat"); dialog.SendMessage(WM_COMMAND,IDC_SEARCH_COUNT);
        check(wait() && status().find(L"4 match") == 0 && status().find(L"Skipped 1") != std::wstring::npos,L"all-open Count includes unsaved file buffers and untitled; reports skipped binary");
        if (!screenshots.empty()) {
            dialog.UpdateWindow(); CRect bounds; dialog.GetWindowRect(bounds); CImage image; image.Create(bounds.Width(),bounds.Height(),32);
            const auto dc = image.GetDC(); const BOOL captured = ::PrintWindow(dialog.GetSafeHwnd(),dc,0); image.ReleaseDC();
            check(captured && SUCCEEDED(image.Save((screenshots / L"find-replace.png").c_str())),L"capture native Find/Replace scope and status layout");
        }
        dialog.SendMessage(WM_COMMAND,IDC_SEARCH_ALL); check(wait() && workspace->multi_search_.matches_.size() == 4,L"all-open Find All provides file/line result rows");
        auto match = workspace->multi_search_.matches_.back(); workspace->NavigateSearchResult(match);
        check(workspace->sessions_[workspace->active_session_] == u && u->text_.Call(SCI_GETSELECTIONEND) - u->text_.Call(SCI_GETSELECTIONSTART) == 3,L"Find All navigates to the matching untitled buffer");
        SearchRequest request; request.all_open = true; request.find = L"cat"; request.action = SearchAction::FindNext; request.wrap = false;
        workspace->ActivateSession(0); a->text_.Call(SCI_SETSEL,original_a.size(),original_a.size()); workspace->ExecuteOpenSearch(request);
        check(wait() && workspace->sessions_[workspace->active_session_] == b && b->text_.Call(SCI_GETSELECTIONSTART) == 0,L"Find Next crosses from current end to following file");
        b->text_.Call(SCI_SETSEL,0,0); request.previous = true; workspace->ExecuteOpenSearch(request);
        check(wait() && workspace->sessions_[workspace->active_session_] == a && a->text_.Call(SCI_GETSELECTIONSTART) == static_cast<LRESULT>(original_a.rfind("cat")),L"Find Previous crosses into preceding file");
        workspace->ActivateSession(3); u->text_.Call(SCI_SETSEL,original_u.size(),original_u.size()); request.previous = false; workspace->ExecuteOpenSearch(request);
        check(wait() && workspace->sessions_[workspace->active_session_] == u && status().find(L"0 match") == 0,L"Wrap off stops at last document");
        request.wrap = true; workspace->ExecuteOpenSearch(request); check(wait() && workspace->sessions_[workspace->active_session_] == a && status().find(L"Wrapped") != std::wstring::npos,L"Wrap on continues from last file to first");
        a->text_.Call(SCI_SETSEL,original_a.size(),original_a.size()); a->OnFindNext(); check(wait() && workspace->sessions_[workspace->active_session_] == b,L"F3 repeats all-open scope across file tabs");
        request.action = SearchAction::Replace; request.replacement = L"dog"; workspace->ExecuteOpenSearch(request);
        check(wait() && b->text_.Utf8() == "dog beta" && a->text_.Utf8() == original_a && u->text_.Utf8() == original_u,L"single Replace changes only selected occurrence in active file"); b->text_.Undo();
        check(b->text_.Utf8() == original_b,L"single cross-file Replace supports native Undo");
        a->ToggleTextClone(); check(a->dual_view_ && a->text_clone_.Utf8() == original_a,L"cloned view shares the same native draft");
        request.action = SearchAction::ReplaceAll; workspace->ExecuteOpenSearch(request);
        check(a->text_.Call(SCI_GETREADONLY) && b->text_.Call(SCI_GETREADONLY) && u->text_.Call(SCI_GETREADONLY),L"Replace All locks every participant while planning");
        check(a->text_clone_.Call(SCI_GETREADONLY),L"replacement lock also protects the cloned view");
        a->text_.ReplaceSel(L"blocked",TRUE); check(a->text_.Utf8() == original_a,L"participant cannot change during replacement planning");
        check(wait() && a->text_.Utf8() == "dog alpha\r\ndog end" && b->text_.Utf8() == "dog beta" && u->text_.Utf8().find("dog ") == 0,L"Replace All applies every match to three open drafts");
        check(a->text_clone_.Utf8() == a->text_.Utf8(),L"replacement is immediately visible in cloned view");
        check(!a->text_.Call(SCI_GETREADONLY) && !b->text_.Call(SCI_GETREADONLY) && !u->text_.Call(SCI_GETREADONLY),L"completed replacement releases editor locks");
        a->text_.Undo(); b->text_.Undo(); u->text_.Undo(); check(a->text_.Utf8() == original_a && b->text_.Utf8() == original_b && u->text_.Utf8() == original_u,L"one Undo in each document restores pre-replacement drafts");
        a->ToggleTextClone();
        std::ifstream disk(a_path,std::ios::binary); const std::string disk_a((std::istreambuf_iterator<char>(disk)),{}); check(disk_a == "cat\n",L"all-open replacement never writes original disk files"); disk.close();
        b->user_read_only_ = true; b->SetSaveReadOnly(false); workspace->ExecuteOpenSearch(request);
        check(!workspace->open_search_io_.valid() && status().find(L"read-only") != std::wstring::npos && a->text_.Utf8() == original_a,L"read-only participant rejects replacement batch without partial changes"); b->user_read_only_ = false; b->SetSaveReadOnly(false);
        workspace->ExecuteOpenSearch(request); workspace->open_search_cancel_ = true;
        check(wait() && a->text_.Utf8() == original_a && b->text_.Utf8() == original_b && u->text_.Utf8() == original_u && !workspace->DocumentLocked(a->document_),L"cancellation leaves every buffer unchanged and releases path locks");
        workspace->ExecuteOpenSearch(request); ++a->revision_; check(wait() && status().find(L"changed while") != std::wstring::npos && b->text_.Utf8() == original_b,L"generation/revision preflight rejects a stale replacement batch");
        workspace->ExecuteOpenSearch(request); check(!workspace->CloseSession(a),L"closing a participating document cancels search and retains its draft"); check(wait() && a->text_.Utf8() == original_a,L"close cancellation does not apply queued replacements");
        request.action = SearchAction::Count; request.mode = 3; request.find = L"c.t"; workspace->ExecuteOpenSearch(request); check(wait() && status().find(L"4 match") == 0,L"all-open regex search uses native text buffers");
        request.find = L"["; workspace->ExecuteOpenSearch(request); check(wait() && status().find(L"Invalid regex") == 0,L"invalid regex is reported without editing files");
        request.mode = 2; request.find = L"\\u672A\\u5B58"; workspace->ExecuteOpenSearch(request); check(wait() && status().find(L"1 match") == 0,L"all-open escaped Unicode search");
        request.mode = 1; request.hex = true; workspace->ExecuteOpenSearch(request); check(!workspace->open_search_io_.valid() && status().find(L"All open documents supports") == 0,L"unsupported cross-file Hex mode is explicit");
        workspace->ActivateSession(0); scope->SetCurSel(0); dialog.SendMessage(WM_COMMAND,MAKEWPARAM(IDC_SEARCH_SCOPE,CBN_SELCHANGE),reinterpret_cast<LPARAM>(scope->GetSafeHwnd())); dialog.SetDlgItemTextW(IDC_SEARCH_TEXT,L"cat"); dialog.SetDlgItemTextW(IDC_REPLACE_TEXT,L"fox"); dialog.SendMessage(WM_COMMAND,IDC_REPLACE_ALL);
        check(Wait(a) && a->text_.Utf8() == "fox alpha\r\nfox end" && b->text_.Utf8() == original_b && u->text_.Utf8() == original_u,L"current-document Replace All remains scoped to active file"); a->text_.Undo();
        dialog.SendMessage(WM_COMMAND,IDCANCEL); workspace->DestroyWindow(); AfxGetApp()->m_pMainWnd = nullptr; return failures;
    }
