            if (std::wstring(title).find(L"Preview replacements -") != 0) return TRUE;
            if (!review_preview_action_) { PostMessageW(window,WM_COMMAND,IDCANCEL,0); return TRUE; }
            const auto list = GetDlgItem(window,2400); LVITEMW item{}; item.stateMask = LVIS_SELECTED; SendMessageW(list,LVM_SETITEMSTATE,static_cast<WPARAM>(-1),reinterpret_cast<LPARAM>(&item));
