            if (wcscmp(title,L"Named bitfield definitions") == 0) { SetDlgItemTextW(window,2400,L"mode 0 16 le 4 8"); PostMessageW(window,WM_COMMAND,IDOK,0); return TRUE; }
            if (wcscmp(title,L"Named bitfields / flags") == 0) { PostMessageW(window,WM_COMMAND,IDOK,0); return TRUE; }
            if (wcscmp(title,L"Edit named bitfield") == 0) { SetDlgItemTextW(window,IDC_VALUE_TEXT,L"12"); PostMessageW(window,WM_COMMAND,IDOK,0); return TRUE; }
