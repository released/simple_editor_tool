    static int RunRegions(const std::filesystem::path& root) {
        int failures = 0; const auto check = [&](bool ok,const wchar_t* label) { std::wcout << (ok ? L"PASS: " : L"FAIL: ") << label << L'\n'; if (!ok) ++failures; };
        const auto a = root / L"regional-left.bin", b = root / L"regional-right.bin"; const std::string first = "abcdefghijklmnop", second = "QRSTUVWX12345678", left_text = std::string(10,'L') + first + second + "TAIL", right_text = std::string(20,'R') + "XY" + first + "Z" + second + "OTHER";
        Write(a,{left_text.begin(),left_text.end()}); Write(b,{right_text.begin(),right_text.end()}); auto* frame = new CMainFrame(false); AfxGetApp()->m_pMainWnd = frame; frame->OpenPath(a.wstring());
        frame->compare_region_spec_ = L"d:10,d:32,d:20,d:35;R:d:20+1"; std::wstring error; simple_editor::core::ParseCompareRegionSpec(frame->compare_region_spec_,&frame->compare_region_,&error); frame->StartCompare(b.wstring(),true);
        check(Wait(frame) && frame->pending_differences_.size() == 2 && frame->pending_differences_[0].right_offset == 21 && frame->compare_left_.CursorOffset() == 10,L"product regional comparison keeps absolute addresses and navigates insertion anchors");
        const auto report = root / L"regional.csv"; check(frame->StartBinaryReport(report.wstring(),0) && Wait(frame),L"regional report uses the product background export command"); const auto csv = ReadDisk(report); const std::string text(csv.begin(),csv.end()); check(text.find("0x0000000000000015") != std::string::npos && text.find("0x0000000000000014") == std::string::npos,L"product regional report excludes the same ignored byte as the list");
        const auto result = root / L"regional-output.bin"; const auto expected = std::string(10,'L') + "Y" + first + "Z" + second + "TAIL"; check(frame->StartBinaryMerge(result.wstring(),true,{0,1}) && Wait(frame) && ReadDisk(result) == std::vector<std::uint8_t>(expected.begin(),expected.end()),L"regional selected-byte merge retains baseline bytes outside the region");
        check(frame->compare_left_.SetLayout(8,2,0x80000000) && frame->compare_right_.SetLayout(8,2,0x90000000) && frame->compare_right_.BaseAddress() == 0x90000000,L"comparison Hex views support independent display bases"); frame->DestroyWindow(); AfxGetApp()->m_pMainWnd = nullptr;
        auto* workspace = new CWorkspaceFrame(false); AfxGetApp()->m_pMainWnd = workspace; workspace->NewComparisonInputs(a.wstring(),b.wstring(),L"",0,false); auto* session = workspace->sessions_[0]; session->compare_region_spec_ = L"d:10,d:32,d:20,d:35;R:d:20+1"; simple_editor::core::ParseCompareRegionSpec(session->compare_region_spec_,&session->compare_region_,&error); session->compare_left_.SetLayout(32,4,0x80000000); const auto entries = workspace->CaptureWorkspace();
        auto* restored = new CWorkspaceFrame(false); restored->RestoreWorkspace(entries); check(restored->sessions_.size() == 1 && restored->sessions_[0]->compare_region_spec_ == session->compare_region_spec_ && restored->sessions_[0]->compare_left_.BytesPerRow() == 32 && restored->sessions_[0]->compare_left_.Grouping() == 4 && restored->sessions_[0]->compare_left_.BaseAddress() == 0x80000000,L"workspace restore retains regional comparison and Hex layout/base settings"); restored->DestroyWindow(); workspace->DestroyWindow(); AfxGetApp()->m_pMainWnd = nullptr; return failures;
    }
