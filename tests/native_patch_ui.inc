    inline static int patch_answer_ = IDOK;
    inline static bool saw_patch_preview_ = false;
    static void CALLBACK PatchPreviewTimer(HWND,UINT,UINT_PTR id,DWORD) { const auto dialog = TestDialog(); if (dialog && ::GetDlgItem(dialog,IDC_TEXT_PREVIEW)) { saw_patch_preview_ = true; ::PostMessageW(dialog,WM_COMMAND,patch_answer_,0); ::KillTimer(nullptr,id); } }
    static int RunTextReports(const std::filesystem::path& root) {
        using namespace simple_editor::core; int failures = 0; const auto check = [&](bool ok,const wchar_t* label) { std::wcout << (ok ? L"PASS: " : L"FAIL: ") << label << L'\n'; if (!ok) ++failures; };
        const auto a = root / L"patch-left.txt", b = root / L"patch-right.txt", patch_path = root / L"change.patch"; Write(a,{'a','\n','b','\n'}); Write(b,{'a','\n','c','\n','e','x','t','r','a','\n'});
        std::atomic_bool cancelled{false}; TextReportStats stats; std::wstring patch,error; BuildUnifiedPatch(L"a\nb\n",L"a\nc\nextra\n",a.wstring(),b.wstring(),cancelled,&patch,&stats,&error); const auto encoded = CCodeEditor::ToUtf8(patch); Write(patch_path,{encoded.begin(),encoded.end()});
        auto* frame = new CMainFrame(false); AfxGetApp()->m_pMainWnd = frame; frame->OpenPath(a.wstring()); frame->ShowPage(1); const auto original = frame->text_.Utf8(); saw_patch_preview_ = false; patch_answer_ = IDCANCEL; auto timer = ::SetTimer(nullptr,0,30,PatchPreviewTimer);
        check(frame->StartPatch(patch_path.wstring()) && Wait(frame),L"patch validation uses the product background job"); ::KillTimer(nullptr,timer); check(saw_patch_preview_ && frame->text_.Utf8() == original && !frame->text_dirty_,L"cancelled validated patch preview retains the current buffer and dirty state");
        saw_patch_preview_ = false; patch_answer_ = IDOK; timer = ::SetTimer(nullptr,0,30,PatchPreviewTimer); const bool started = frame->StartPatch(patch_path.wstring()), finished = Wait(frame); ::KillTimer(nullptr,timer);
        check(started && finished && saw_patch_preview_ && frame->text_.Utf8() == "a\r\nc\r\nextra\r\n" && frame->text_dirty_,L"approved patch changes the actual editor and marks it dirty"); check(ReadDisk(a) == std::vector<std::uint8_t>({'a',10,'b',10}),L"applying a patch keeps the original disk file intact until Save"); frame->OnUndo(); check(frame->text_.Utf8() == original && frame->text_.CanRedo(),L"one Undo restores the pre-patch text and enables Redo"); frame->OnRedo(); check(frame->text_.Utf8().find("extra") != std::string::npos,L"native Redo reapplies the patch transaction"); frame->OnUndo();
        frame->text_.SetSel(0,1); frame->text_.ReplaceSel(L"changed",TRUE); const auto newer = frame->text_.Utf8(); saw_patch_preview_ = false; check(frame->StartPatch(patch_path.wstring()) && Wait(frame) && !saw_patch_preview_ && frame->text_.Utf8() == newer && frame->status_.GetPaneText(0).Find(L"SHA-256") >= 0,L"a stale generated patch is rejected before preview or mutation"); frame->DestroyWindow();
        frame = new CMainFrame(false); AfxGetApp()->m_pMainWnd = frame; frame->displayed_mode_ = 2; frame->EnsureAdvanced(); auto& view = frame->advanced_; auto left = std::make_unique<BinaryDocument>(), right = std::make_unique<BinaryDocument>(); left->Open(a.wstring(),&error); right->Open(b.wstring(),&error); view.StartText(nullptr,std::move(left),std::move(right)); frame->ShowPage(2); check(Wait(frame),L"prepare original text snapshots for report export");
        const auto report = root / L"comparison.html"; check(view.StartTextReport(report.wstring(),TextReportFormat::Html) && Wait(frame) && !ReadDisk(report).empty(),L"text report export runs through the actual comparison view");
        const auto exported = root / L"exported.patch"; check(view.StartTextReport(exported.wstring(),TextReportFormat::UnifiedPatch) && Wait(frame) && !ReadDisk(exported).empty(),L"comparison view exports its source pair as a unified patch");
        check(view.StartTextReport(a.wstring(),TextReportFormat::Summary) && Wait(frame) && ReadDisk(a) == std::vector<std::uint8_t>({'a',10,'b',10}),L"comparison report cannot overwrite a source snapshot");
        saw_patch_preview_ = false; timer = ::SetTimer(nullptr,0,30,PatchPreviewTimer); const bool merged_started = frame->StartPatch(exported.wstring()), merged_finished = Wait(frame); ::KillTimer(nullptr,timer); check(merged_started && merged_finished && saw_patch_preview_ && view.output_.Utf8() == "a\r\nc\r\nextra\r\n",L"validated patch can update an editable merged-output buffer"); view.Undo(); check(view.output_.Utf8() == original,L"merged-output patch uses the shared manual/block Undo history");
        frame->DestroyWindow(); AfxGetApp()->m_pMainWnd = nullptr; return failures;
    }
