    static int RunLocalization(const std::filesystem::path& root,const std::filesystem::path& screenshots = {}) {
        using namespace simple_editor::core; using namespace simple_editor::ui;
        int failures = 0; const auto check = [&](bool ok,const wchar_t* name) { std::wcout << (ok ? L"PASS: " : L"FAIL: ") << name << L'\n'; if (!ok) ++failures; };
        const auto catalogs = root / L"languages"; std::filesystem::create_directories(catalogs); const auto originals = std::filesystem::current_path() / L"src" / L"res";
        for (const auto name : {L"lang_en.ini",L"lang_tw.ini"}) std::filesystem::copy_file(originals / name,catalogs / name);
        std::wstring error; check(InitializeLocalization(catalogs,L"tw",&error),L"initialize isolated Traditional Chinese catalogs and own-thread UI localization");
        auto* workspace = new CWorkspaceFrame(false); AfxGetApp()->m_pMainWnd = workspace; workspace->SetWindowPos(nullptr,0,0,1280,900,SWP_NOACTIVATE | SWP_NOZORDER); workspace->ShowWindow(SW_SHOW);
        const auto text_of = [](CWnd& window) { CString text; window.GetWindowTextW(text); return std::wstring(text.GetString()); };
        check(UiLanguage() == L"tw" && text_of(workspace->open_button_) == L"開啟檔案…" && text_of(workspace->close_button_) == L"關閉分頁",L"welcome controls display Traditional Chinese without an existing settings file");
        CString menu_label; workspace->root_menu_.GetMenuString(0,menu_label,MF_BYPOSITION); check(menu_label == L"檔案(&F)",L"top-level native menu is translated at first display");
        const auto path = root / L"Open files... .txt"; const std::string body = "Open files...\nSave\nText\n"; Write(path,{body.begin(),body.end()}); workspace->OpenPath(path.wstring()); auto* editor = workspace->sessions_.back(); editor->text_.SetSel(0,0); editor->text_.ReplaceSel(L"草稿\U0001F680\r\n",TRUE); editor->ToggleTextClone(); editor->text_.Call(SCI_SETSEL,3,10); int before_begin,before_end; editor->text_.GetSel(before_begin,before_end); const auto content = editor->text_.Utf8(); const auto generation = editor->text_.Generation(); const auto revision = editor->revision_; const auto undo = editor->text_.CanUndo();
        wchar_t tab_text[80]{}; TCITEMW tab{}; tab.mask = TCIF_TEXT; tab.pszText = tab_text; tab.cchTextMax = 80; editor->tabs_.GetItem(1,&tab); check(std::wstring(tab_text) == L"文字",L"internal Hex/Text/Compare tabs use translated names");
        CString path_text; workspace->sessions_tab_.GetItem(0,&tab); check(editor->document_.Path() == path.wstring(),L"document filename/path remains untouched even when it contains UI words");
        const auto preferences = root / L"preferences.ini"; { std::ofstream file(preferences,std::ios::binary); file << "[private]\nkeep=original\n[simpleeditortool.preferences]\nlanguage=tw\n"; } workspace->preferences_path_ = preferences;
        workspace->SendMessage(WM_COMMAND,ID_LANGUAGE_ENGLISH); check(UiLanguage() == L"en" && text_of(workspace->open_button_) == L"Open files...",L"language command immediately switches existing welcome and hidden session UI to English");
        editor->tabs_.GetItem(1,&tab); int begin,end; editor->text_.GetSel(begin,end);
        check(std::wstring(tab_text) == L"Text" && editor->text_.Utf8() == content && editor->text_clone_.Utf8() == content && editor->text_.Generation() == generation && editor->revision_ == revision && editor->text_.CanUndo() == undo && begin == before_begin && end == before_end && end > begin,L"switching language preserves shared drafts, selection, generation, revision and native Undo");
        workspace->SendMessage(WM_COMMAND,ID_LANGUAGE_TRADITIONAL); workspace->SendMessage(WM_COMMAND,ID_LANGUAGE_ENGLISH); workspace->SendMessage(WM_COMMAND,ID_LANGUAGE_TRADITIONAL);
        const auto wait_preferences = [&]() { const auto deadline = GetTickCount64() + 10000; while (workspace->preferences_io_.valid() && GetTickCount64() < deadline) { workspace->TickPreferences(); Sleep(1); } return !workspace->preferences_io_.valid(); };
        AppPreferences loaded; check(wait_preferences() && LoadPreferences(preferences,&loaded,&error) && loaded.language == L"tw",L"rapid switches persist the newest choice after earlier asynchronous preference writes");
        editor->OnFind(); auto& find = workspace->scoped_search_; find.SetDlgItemTextW(IDC_SEARCH_TEXT,L"Open files..."); find.SetDlgItemTextW(IDC_REPLACE_TEXT,L"Save"); auto* scope = static_cast<CComboBox*>(find.GetDlgItem(IDC_SEARCH_SCOPE)); scope->SetCurSel(1); const auto find_generation = editor->text_.Generation();
        check(text_of(find) == L"尋找／取代" && text_of(*find.GetDlgItem(IDOK)) == L"找下一個",L"existing native Find/Replace dialog caption and actions are translated");
        workspace->SendMessage(WM_COMMAND,ID_LANGUAGE_ENGLISH); CString query,replacement; find.GetDlgItemTextW(IDC_SEARCH_TEXT,query); find.GetDlgItemTextW(IDC_REPLACE_TEXT,replacement); check(text_of(find) == L"Find / Replace" && query == L"Open files..." && replacement == L"Save" && scope->GetCurSel() == 1 && editor->text_.Generation() == find_generation,L"runtime dialog switching preserves user search/replacement input and fixed-list selection");
        workspace->SendMessage(WM_COMMAND,ID_LANGUAGE_TRADITIONAL); find.GetDlgItemTextW(IDC_SEARCH_TEXT,query); check(query == L"Open files...",L"editable search history is excluded from translation even for exact matching UI labels");
        if (!screenshots.empty()) { std::filesystem::create_directories(screenshots); ExpansionCapture(find,screenshots / L"find-traditional.png"); }
        find.SendMessage(WM_COMMAND,IDCANCEL);
        const auto other = root / L"other.txt"; Write(other,{'d','i','f','f','e','r','e','n','t'}); workspace->NewComparisonInputs(path.wstring(),other.wstring(),L"",2,true); auto* comparison = workspace->sessions_.back(); check(Wait(comparison) && comparison->advanced_.model_,L"translated comparison builds its regular source model"); auto& advanced = comparison->advanced_; const auto left = advanced.source_left_.Utf8(),right = advanced.source_right_.Utf8(),output = advanced.output_.Utf8(); const auto source_generation = advanced.source_left_.Generation();
        check(text_of(advanced.take_left_) == L"採用左側" && text_of(advanced.ignore_case_) == L"忽略大小寫",L"comparison source/merge actions display Traditional Chinese");
        workspace->SendMessage(WM_COMMAND,ID_LANGUAGE_ENGLISH); workspace->SendMessage(WM_COMMAND,ID_LANGUAGE_TRADITIONAL); check(advanced.source_left_.Utf8() == left && advanced.source_right_.Utf8() == right && advanced.output_.Utf8() == output && advanced.source_left_.Generation() == source_generation && advanced.source_left_.Call(SCI_GETREADONLY),L"comparison language changes retain immutable sources, output and version state");
        if (!screenshots.empty()) ExpansionCapture(*workspace,screenshots / L"workspace-traditional.png");
        workspace->ActivateSession(0); editor->ShowPage(0); const auto disk_before = ReadDisk(path); editor->document_.SetByte(0,'X'); editor->DocumentChanged(); editor->hex_.GoTo(4); const auto save_revision = editor->revision_; check(editor->StartSave((root / L"saved.txt").wstring()),L"start a real background save before language change"); workspace->SendMessage(WM_COMMAND,ID_LANGUAGE_ENGLISH); check(editor->revision_ == save_revision && editor->hex_.CursorOffset() == 4 && Wait(editor) && !editor->document_.IsModified() && ReadDisk(path) == disk_before,L"language switching during Save preserves snapshot, caret and source protection");
        for (auto* frame : workspace->sessions_) { frame->text_dirty_ = false; frame->text_.SetModify(FALSE); frame->document_.Close(); frame->advanced_.dirty_ = false; } wait_preferences(); workspace->DestroyWindow(); AfxGetApp()->m_pMainWnd = nullptr; ShutdownLocalization();
        check(!InitializeLocalization(root / L"missing",L"tw",&error) && UiLanguage() == L"en" && Localize(L"Open files...") == L"Open files..." && !SetUiLanguage(L"tw"),L"missing language files retain usable English and cannot falsely activate Chinese"); ShutdownLocalization();
        return failures;
    }
