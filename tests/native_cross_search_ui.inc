        editor->text_.SetSel(editor->text_.GetWindowTextLengthW(),editor->text_.GetWindowTextLengthW()); editor->text_.ReplaceSel(L"!",TRUE); const auto caret = editor->text_.Call(SCI_GETCURRENTPOS); workspace->NavigateSearchResult(open_match); check(editor->text_.Call(SCI_GETCURRENTPOS) == caret,L"edited buffers reject stale open-file search selections");
