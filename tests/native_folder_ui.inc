    static int RunFolderTools(const std::filesystem::path& root) {
        using namespace simple_editor::core;
        int failures = 0; const auto check = [&](bool ok,const wchar_t* text) { std::wcout << (ok ? L"PASS: " : L"FAIL: ") << text << L'\n'; if (!ok) ++failures; };
        const auto left = root / L"folder-ui-left", right = root / L"folder-ui-right"; std::filesystem::create_directories(left); std::filesystem::create_directories(right);
        Write(left / L"a.txt",{'A'}); Write(right / L"a.txt",{'B'}); Write(left / L"z.txt",{'x','y'}); Write(right / L"z.txt",{'x','y'}); Write(left / L"left.txt",{'L'});
        auto* workspace = new CWorkspaceFrame(false); AfxGetApp()->m_pMainWnd = workspace; workspace->NewComparisonInputs(left.wstring(),right.wstring(),L"",4,true); auto* frame = workspace->sessions_[0]; auto& view = frame->advanced_;
        check(Wait(frame) && view.scan_ && view.scan_->rows.size() == 3,L"folder UI performs default content comparison");
        view.folder_filter_.SetCurSel(1); view.OnFilterChanged(); check(view.visible_.size() == 1 && view.Cell(0,0) == L"a.txt",L"folder filter preserves underlying scan row identity");
        view.folder_filter_.SetCurSel(0); view.OnFilterChanged(); NMLISTVIEW header{}; header.iSubItem = 2; LRESULT result = 0; view.OnFolderColumn(&header.hdr,&result); view.OnFolderColumn(&header.hdr,&result); check(view.Cell(0,0) == L"z.txt" && view.rows_.GetSelectedCount() == 0,L"numeric column sort reorders rows and clears unsafe index selections");
        view.folder_criterion_.SetCurSel(1); view.OnRulesChanged(); check(view.stale_ && view.rows_.GetItemCount() == 0,L"changing comparison criterion invalidates stale rows before sync"); frame->OnCompareRun(); check(Wait(frame) && view.scan_->rows[0].state == FolderState::Equal,L"size comparison is available through product controls");
        view.folder_criterion_.SetCurSel(3); view.folder_tolerance_.SetCurSel(2); view.folder_filter_.SetCurSel(8); WorkspaceEntry saved; view.CapturePreferences(saved); view.folder_criterion_.SetCurSel(0); view.RestorePreferences(saved);
        check(view.folder_criterion_.GetCurSel() == 3 && view.folder_tolerance_.GetCurSel() == 2 && view.folder_filter_.GetCurSel() == 8 && view.folder_sort_descending_,L"native controls retain persisted folder criteria and view preferences");
        view.folder_filter_.SetCurSel(0); view.folder_criterion_.SetCurSel(0); view.OnRulesChanged(); frame->OnCompareRun(); Wait(frame);
        const auto baseline = root / L"ui-baseline.setb"; check(view.StartBaselineSave(baseline.wstring()) && Wait(frame) && view.baseline_path_ == baseline.wstring(),L"product baseline command hashes files in the background and adopts its saved path");
        Write(left / L"a.txt",{'C'}); Write(right / L"z.txt",{'D'}); frame->OnCompareRun(); Wait(frame); view.folder_filter_.SetCurSel(1); view.OnFilterChanged(); view.sync_policy_.SetCurSel(3); preview_accept_ = true; auto timer = ::SetTimer(nullptr,0,40,PreviewTimer); view.PlanSync(true,true); const auto synced = Wait(frame); ::KillTimer(nullptr,timer);
        check(synced && ReadDisk(right / L"a.txt") == std::vector<std::uint8_t>{'C'} && ReadDisk(left / L"z.txt") == std::vector<std::uint8_t>{'D'},L"baseline UI preview applies independent changes in both directions");
        check(!view.last_journal_.empty() && std::filesystem::exists(view.last_journal_),L"completed folder operations expose their persistent journal path");
        const auto journal = view.last_journal_; timer = ::SetTimer(nullptr,0,40,PreviewTimer); const auto launched = view.StartJournalPlan(journal,true); const auto restored = Wait(frame); ::KillTimer(nullptr,timer);
        check(launched && restored && ReadDisk(left / L"z.txt") == std::vector<std::uint8_t>({'x','y'}) && ReadDisk(right / L"a.txt") == std::vector<std::uint8_t>{'C'},L"journal recovery uses the same guarded native preview and restores only that operation group");
        SyncBundle bundle; SyncPlan plan; plan.source_root = left; plan.target_root = right; plan.operations.push_back({L"sub",SyncAction::CreateDirectory,{},{}}); plan.operations.push_back({L"sub/file",SyncAction::Copy,{},{}}); plan.operations.push_back({L"other",SyncAction::Copy,{},{}}); bundle.plans.push_back(plan); bundle.conflicts.push_back({L"conflict",L"Both changed"});
        CSyncPreview preview(std::move(bundle),workspace); preview.Create(IDD_SYNC_PREVIEW,workspace); preview.list_.SetItemState(0,LVIS_SELECTED,LVIS_SELECTED); preview.SkipSelected(); auto included = preview.Selected(); check(included.plans[0].operations.size() == 1 && included.plans[0].operations[0].relative == L"other",L"preview excludes a selected subtree while preserving unrelated operations");
        preview.list_.SetItemState(3,LVIS_SELECTED,LVIS_SELECTED); preview.SkipSelected(); check(preview.Selected().conflicts.empty(),L"conflicts require an explicit preview exclusion before applying independent operations"); preview.DestroyWindow();
        workspace->DestroyWindow(); AfxGetApp()->m_pMainWnd = nullptr; return failures;
    }
