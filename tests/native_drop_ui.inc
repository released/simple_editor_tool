    static int RunDropTargets(const std::filesystem::path& root) {
        int failures = 0; const auto check = [&](bool ok,const wchar_t* label) { std::wcout << (ok ? L"PASS: " : L"FAIL: ") << label << L'\n'; if (!ok) ++failures; }; const auto a = root / L"drop-original.txt", b = root / L"drop-中.txt", c = root / L"drop-third.bin", d = root / L"drop-readonly.txt"; Write(a,{'a','b','c'}); Write(b,{'B'}); Write(c,{0,1,2}); Write(d,{'D'});
        auto* workspace = new CWorkspaceFrame(false); AfxGetApp()->m_pMainWnd = workspace; workspace->OpenPath(a.wstring()); auto* editor = workspace->sessions_[0]; editor->ShowPage(1); editor->text_.SetSel(0,1); editor->text_.ReplaceSel(L"draft",TRUE); const auto draft = editor->text_.Utf8(); const auto generation = editor->text_.Generation(); auto* target = editor->text_.drop_target_; check(target != nullptr,L"native Text editor registers a file-aware OLE drop target"); if (!target) { workspace->DestroyWindow(); return 1; } target->AddRef();
        auto* files = new TestDropData(std::vector<std::wstring>{b.wstring(),c.wstring()}); DWORD effect = DROPEFFECT_COPY; POINTL point{}; target->DragEnter(files,0,point,&effect); check(effect == DROPEFFECT_COPY,L"Text drop target advertises file-list support"); target->Drop(files,0,point,&effect); files->Release();
        check(workspace->sessions_.size() == 3,L"OLE multi-file drop into Text opens every file in retained tabs"); check(editor->text_.Utf8() == draft && editor->text_.Generation() == generation && editor->text_.CanUndo() && editor->text_.GetModify(),L"Text file drop preserves the old draft, native Undo and buffer identity");
        editor->text_.SetReadOnly(TRUE); files = new TestDropData(std::vector<std::wstring>{d.wstring()}); effect = DROPEFFECT_COPY; target->DragEnter(files,0,point,&effect); target->Drop(files,0,point,&effect); files->Release(); check(workspace->sessions_.size() == 4 && editor->text_.Utf8() == draft,L"file opening remains available over a read-only Text view");
        auto* text = new TestDropData(std::wstring(L"copied text")); effect = DROPEFFECT_COPY; target->DragEnter(text,0,point,&effect); check(effect == DROPEFFECT_NONE,L"read-only Text rejects dropped text mutations"); target->Drop(text,0,point,&effect); check(editor->text_.Utf8() == draft,L"rejected text drop retains every byte of the draft");
        editor->text_.SetReadOnly(FALSE); effect = DROPEFFECT_COPY; target->DragEnter(text,0,point,&effect); target->Drop(text,0,point,&effect); text->Release(); check(effect == DROPEFFECT_COPY && editor->text_.Utf8().find("copied text") != std::string::npos,L"external Unicode text drops copy text through native Undo"); editor->OnUndo(); check(editor->text_.Utf8() == draft,L"one Undo restores a copied text drop");
        files = new TestDropData(CF_HDROP,{1,2,3}); effect = DROPEFFECT_COPY; target->DragEnter(files,0,point,&effect); target->Drop(files,0,point,&effect); files->Release(); check(effect == DROPEFFECT_NONE && workspace->sessions_.size() == 4,L"malformed OLE file data is rejected without opening/replacing a tab");
        target->Release(); workspace->DestroyWindow(); AfxGetApp()->m_pMainWnd = nullptr; return failures;
    }
