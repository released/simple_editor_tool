        const auto file = root / L"recent-file.txt"; Write(file,{'r'}); workspace->OpenPath(file.wstring()); workspace->preferences_close_pending_ = true; workspace->OpenPath(file.wstring()); check(!workspace->preferences_close_pending_,L"opening a file cancels a pending preference-save exit continuation"); workspace->StartPreferenceWrite(); wait(); AppPreferences loaded; check(LoadPreferences(ini,&loaded,&error) && loaded.font == p.font && loaded.theme == 1 && loaded.shortcuts[0].key == 'Q' && !loaded.recent.empty() && loaded.recent[0] == file.wstring(),L"portable settings retain font/theme/shortcuts and recent paths across workspace lifetimes");
