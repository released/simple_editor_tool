    static int RunDiscovery(const std::filesystem::path& root) {
        int failures = 0; const auto check = [&](bool ok,const wchar_t* name) { std::wcout << (ok ? L"PASS: " : L"FAIL: ") << name << L'\n'; if (!ok) ++failures; }; const auto source = root / L"discovery.txt"; Write(source,{'b','\n','a','\n','b','\n'}); auto* workspace = new CWorkspaceFrame(false); AfxGetApp()->m_pMainWnd = workspace; workspace->OpenPath(source.wstring()); auto* frame = workspace->sessions_[0];
        simple_editor::core::NamedHexRange range; range.name = L"Header"; range.comment = L"Known region"; range.offset = 1; range.length = 2; simple_editor::core::InspectFile(source,&frame->bookmarks_.source,nullptr); check(frame->bookmarks_.Add(range,frame->document_.Size(),nullptr) && frame->hex_.bookmarks == &frame->bookmarks_,L"native Hex view consumes its owning document's named range markers");
        auto entries = workspace->CaptureWorkspace(); auto* restored = new CWorkspaceFrame(false); restored->RestoreWorkspace(entries); check(restored->sessions_[0]->bookmarks_.ranges.size() == 1 && restored->sessions_[0]->bookmarks_.Matches(restored->sessions_[0]->document_),L"workspace restore retains current physical range bookmarks"); restored->DestroyWindow();
        frame->ShowPage(1); const auto original = frame->text_.Utf8(); frame->StartTextCommand(ID_FEATURE_SORT_ASC); check(Wait(frame) && frame->text_.Utf8() == "a\r\nb\r\nb\r\n" && frame->text_.CanUndo(),L"line sorting runs through the background command slot and native Undo"); frame->OnUndo(); check(frame->text_.Utf8() == original,L"one Undo restores the complete line operation"); frame->OnRedo(); frame->StartTextCommand(ID_FEATURE_DEDUP); check(Wait(frame) && frame->text_.Utf8() == "a\r\nb\r\n" && frame->bookmarks_.stale,L"deduplication retains first lines and document edits invalidate old byte bookmarks");
        frame->ToggleTextClone(); const auto shared = frame->text_.Call(SCI_GETDOCPOINTER); check(frame->dual_view_ && frame->text_clone_.Call(SCI_GETDOCPOINTER) == shared && frame->text_clone_.Utf8() == frame->text_.Utf8(),L"two native Text views share a single document rather than copying drafts"); frame->clone_active_ = true; frame->text_clone_.SetSel(-1,-1); frame->text_clone_.ReplaceSel(L"shared draft",TRUE); check(frame->text_.Utf8().find("shared draft") != std::string::npos && frame->text_dirty_,L"edits from the second view update the owning draft"); frame->OnUndo(); check(frame->text_clone_.Utf8() == frame->text_.Utf8() && frame->text_.Utf8().find("shared draft") == std::string::npos,L"shared Undo is coherent from the second view"); frame->text_clone_.SetSel(-1,-1); frame->text_clone_.ReplaceSel(L"saved from clone",TRUE); const auto saved = frame->text_.Utf8(); const auto output = root / L"clone-saved.txt"; check(frame->StartSave(output.wstring()) && frame->text_clone_.Call(SCI_GETREADONLY),L"saving locks both views of the shared file buffer"); check(Wait(frame) && !frame->text_clone_.Call(SCI_GETREADONLY) && frame->text_.Utf8() == saved && frame->text_clone_.Utf8() == saved,L"a shared-view save preserves both native buffers and releases their lock");
        std::atomic_bool cancel{false}; std::string transformed; std::wstring error; check(TransformEditorLines("z\n\n a \nz",2,cancel,&transformed,&error) && transformed == "z\n\n a ",L"line transformations preserve logical missing-final-newline behavior"); check(CompleteDocumentWords("variable_one variable_two unrelated var","var","var virtual",cancel) == "variable_one variable_two",L"completion combines prefix-matching document and language words without duplicates"); cancel = true; check(CompleteDocumentWords("variable_one","var","virtual",cancel).empty(),L"cancelled completion indexing publishes no stale candidates");
        frame->ShowPage(0); frame->hex_.GoTo(0); frame->ShowLiveInspector(); auto inspection = frame->live_inspector_.inspect(true); check(inspection.writable && inspection.values.size() == 10,L"live inspector follows the current writable Hex source"); check(frame->live_inspector_.write(inspection,L"uint16",L"513",true,&error),L"live inspector writes an exact-width endian-aware scalar transaction"); std::vector<std::uint8_t> bytes; frame->document_.Read(0,2,&bytes); const auto stale_write = frame->live_inspector_.write(inspection,L"uint16",L"1",true,&error); if (bytes != std::vector<std::uint8_t>({1,2}) || stale_write) { std::wcout << L"DETAIL: bytes="; for (auto v : bytes) std::wcout << static_cast<unsigned>(v) << L","; std::wcout << L" stale_write=" << stale_write << L" old_revision=" << inspection.revision << L" now=" << frame->revision_ << L" error=" << error << L"\n"; } check(bytes == std::vector<std::uint8_t>({1,2}) && !stale_write,L"scalar writes produce exact bytes and reject stale field versions"); frame->document_.Undo(nullptr); frame->live_inspector_.ShowWindow(SW_HIDE);
        const auto a = root / L"keys-left.csv",b = root / L"keys-right.csv"; const std::string left = "id,value\na,1\nb,2\n",right = "value,id\n2.005,b\n1,a\n"; Write(a,{left.begin(),left.end()}); Write(b,{right.begin(),right.end()}); workspace->NewComparisonInputs(a.wstring(),b.wstring(),L"",5,true); auto* table = workspace->sessions_.back(); check(Wait(table),L"native mapped-table fixture initially compares through ordinary paths");
        const auto timer = ::SetTimer(nullptr,0,40,[](HWND,UINT,UINT_PTR,DWORD) { const auto dialog = TestDialog(); if (::GetDlgItem(dialog,2400) && ::GetDlgItem(dialog,2401)) { ::SetDlgItemTextW(dialog,2400,L"header=yes\r\n1,2,key\r\n2,1,0.01"); ::PostMessageW(dialog,WM_COMMAND,IDOK,0); } }); table->OnFeature(ID_FEATURE_TABLE_RULES); ::KillTimer(nullptr,timer); table->OnCompareRun(); check(Wait(table) && table->advanced_.structured_ && table->advanced_.structured_->different == 0,L"native comparison settings apply key mapping and exact tolerance to reordered CSV data"); entries = workspace->CaptureWorkspace(); check(entries.back().table_rules.find(L"1,2,key") != std::wstring::npos,L"native table rules persist with their comparison session");
        workspace->DestroyWindow(); AfxGetApp()->m_pMainWnd = nullptr; return failures;
    }
