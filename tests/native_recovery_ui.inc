    static int RunRecovery(const std::filesystem::path& root) {
        using namespace simple_editor::core;
        int failures = 0; const auto check = [&](bool ok,const wchar_t* label) { std::wcout << (ok ? L"PASS: " : L"FAIL: ") << label << L'\n'; if (!ok) ++failures; };
        const auto source = root / L"recover-source.txt",archive = root / L"native-recovery"; Write(source,{'l','i','n','e','\n'}); const auto original = ReadDisk(source);
        auto* workspace = new CWorkspaceFrame(false); AfxGetApp()->m_pMainWnd = workspace;
        check(workspace->recovery_root_.empty() && !workspace->recovery_initialized_,L"default workspaces do not create recovery storage or auto-open files");
        workspace->NewDocument(); auto* draft = workspace->sessions_[0]; draft->text_.ReplaceSel(L"草稿 😀\r\n",TRUE); const auto text = draft->text_.Utf8(); const auto generation = draft->text_.Generation(); CString title; workspace->GetWindowTextW(title); check(title.Find(L"Untitled") >= 0 && title.Find(L"AppData") < 0,L"editing an untitled document keeps its temporary backing path out of the window title");
        workspace->OpenPath(source.wstring()); auto* file = workspace->sessions_[1]; file->ShowPage(1); file->text_.SetSel(0,4); file->text_.ReplaceSel(L"LINE",TRUE); workspace->NewDocument(); workspace->sessions_[2]->untitled_dirty_ = true;
        workspace->recovery_root_ = archive; workspace->recovery_initialized_ = true; workspace->preferences_.recover_drafts = true; workspace->preferences_.auto_restore = true;
        const auto wait = [&](CWorkspaceFrame* current) { const auto deadline = std::chrono::steady_clock::now() + std::chrono::seconds(20); while (current->recovery_io_.valid() && std::chrono::steady_clock::now() < deadline) { MSG message{}; while (::PeekMessage(&message,nullptr,0,0,PM_REMOVE)) { ::TranslateMessage(&message); ::DispatchMessage(&message); } current->TickRecovery(); ::Sleep(1); } return !current->recovery_io_.valid(); };
        check(workspace->StartRecoverySnapshot(false) && wait(workspace),L"native workspace snapshots its file and untitled drafts in a background recovery job"); RecoveryIndex index; std::wstring error; LoadRecovery(archive,&index,&error);
        check(index.drafts.size() == 3 && index.workspace.size() == 1 && ReadDisk(source) == original && draft->text_.Utf8() == text && draft->text_.Generation() == generation && draft->text_.CanUndo(),L"recovery captures all drafts, including empty drafts, while preserving original bytes and live Undo");
        check(workspace->StartRecoveryRead(index,{0,1,2}) && wait(workspace) && workspace->sessions_.size() == 6,L"restoring recovery copies appends independent retained file tabs");
        auto* recovered = workspace->sessions_[3]; auto* empty = workspace->sessions_[5]; check(recovered->untitled_ && recovered->untitled_dirty_ && recovered->text_.Utf8() == text && recovered->document_.Path() != source.wstring() && empty->document_.Size() == 0 && empty->untitled_dirty_ && ReadDisk(source) == original,L"recovered data stays untitled and empty recovered drafts still require an explicit save decision");
        saw_picker_ = false; auto timer = ::SetTimer(nullptr,0,40,PickerCancelTimer); const auto cancelled = !recovered->SaveCurrent(); ::KillTimer(nullptr,timer); check(cancelled && saw_picker_ && recovered->untitled_ && ReadDisk(source) == original,L"saving a recovered draft asks for Save As and Cancel never overwrites its original");
        auto* restarted = new CWorkspaceFrame(false); AfxGetApp()->m_pMainWnd = restarted; restarted->recovery_root_ = archive; restarted->recovery_initialized_ = true; restarted->preferences_.auto_restore = restarted->preferences_.recover_drafts = true;
        timer = ::SetTimer(nullptr,0,40,[](HWND,UINT,UINT_PTR,DWORD) { const auto dialog = TestDialog(); if (::GetDlgItem(dialog,2100)) ::PostMessageW(dialog,WM_COMMAND,2101,0); }); const auto began = restarted->StartRecoveryLoad(false); const auto restored = wait(restarted); ::KillTimer(nullptr,timer);
        check(began && restored && restarted->sessions_.size() == 4 && restarted->sessions_[0]->document_.Path() == source.wstring() && restarted->sessions_[1]->untitled_ && ReadDisk(source) == original,L"startup restore reopens configured paths and offers separate crash-draft copies without saving originals");
        restarted->DestroyWindow(); AfxGetApp()->m_pMainWnd = workspace;
        check(workspace->StartRecoverySnapshot(false),L"a recovery snapshot can run independently of subsequent workspace opening"); workspace->recovery_close_pending_ = true; workspace->OpenPath(source.wstring()); check(!workspace->recovery_close_pending_ && wait(workspace),L"opening a file cancels a pending recovery-save exit continuation");
        confirm_command_ = IDYES; timer = ::SetTimer(nullptr,0,40,ConfirmationTimer); const auto clearing = workspace->StartRecoveryClear(); ::KillTimer(nullptr,timer); check(clearing && wait(workspace) && LoadRecovery(archive,&index,&error) && index.generation.empty() && ReadDisk(source) == original,L"native recovery clearing confirms and removes only owned copies while keeping original files"); workspace->DestroyWindow(); AfxGetApp()->m_pMainWnd = nullptr;
        auto* clean = new CWorkspaceFrame(false); AfxGetApp()->m_pMainWnd = clean; clean->recovery_root_ = root / L"clean-recovery"; clean->recovery_initialized_ = true; clean->preferences_.auto_restore = true; clean->OpenPath(source.wstring()); const auto clean_root = clean->recovery_root_; const HWND window = clean->GetSafeHwnd(); clean->OnClose();
        const auto deadline = std::chrono::steady_clock::now() + std::chrono::seconds(20); while (::IsWindow(window) && std::chrono::steady_clock::now() < deadline) { MSG message{}; while (::PeekMessage(&message,nullptr,0,0,PM_REMOVE)) { ::TranslateMessage(&message); ::DispatchMessage(&message); } if (!::IsWindow(window)) break; clean->TickRecovery(); ::Sleep(1); }
        check(!::IsWindow(window) && LoadRecovery(clean_root,&index,&error) && index.clean_exit && index.workspace.size() == 1 && index.drafts.empty(),L"normal exit preserves path/view restore state after per-file close decisions without reviving discarded drafts"); AfxGetApp()->m_pMainWnd = nullptr;
        auto* next = new CWorkspaceFrame(false); AfxGetApp()->m_pMainWnd = next; next->recovery_root_ = clean_root; next->recovery_initialized_ = true; next->preferences_.auto_restore = true; check(next->StartRecoveryLoad(false) && wait(next) && next->sessions_.size() == 1 && next->sessions_[0]->document_.Path() == source.wstring(),L"clean workspace startup restores file tabs without a draft recovery prompt"); next->DestroyWindow(); AfxGetApp()->m_pMainWnd = nullptr; return failures;
    }
