    static int RunDocuments(const std::filesystem::path& root) {
        int failures = 0; const auto check = [&](bool ok,const wchar_t* text) { std::wcout << (ok ? L"PASS: " : L"FAIL: ") << text << L'\n'; if (!ok) ++failures; };
        auto* workspace = new CWorkspaceFrame(false); AfxGetApp()->m_pMainWnd = workspace;
        check(workspace->NewDocument() && workspace->sessions_.size() == 1,L"New creates an independent native untitled file editor"); auto* draft = workspace->sessions_[0]; const auto backing = draft->document_.Path();
        check(draft->untitled_ && draft->document_.Size() == 0 && draft->active_tab_ == 1 && draft->text_editable_ && workspace->OpenPaths()[0] == draft->untitled_name_,L"empty untitled documents edit as UTF-8 and display a user-facing session name");
        check(!draft->StartSave(backing),L"normal Save cannot write an internal empty backing file"); draft->text_.ReplaceSel(L"中文 draft\r\n",TRUE); const auto text = draft->text_.Utf8(); const auto generation = draft->text_.Generation();
        workspace->NewDocument(); auto* empty = workspace->sessions_[1]; const auto second_backing = empty->document_.Path(); check(draft->text_.Utf8() == text && draft->text_.Generation() == generation && draft->text_.CanUndo(),L"New retains every existing draft and its native Undo buffer");
        std::wstring error; auto snapshot = workspace->SnapshotForPath(draft->untitled_name_,&error); check(snapshot && snapshot->Size() == text.size() && !std::filesystem::file_size(backing),L"untitled comparison snapshots include draft bytes without writing the backing file"); snapshot.reset();
        saw_picker_ = false; auto timer = ::SetTimer(nullptr,0,40,PickerCancelTimer); const auto cancelled = !draft->SaveCurrent(); ::KillTimer(nullptr,timer); check(cancelled && saw_picker_ && draft->untitled_ && draft->text_.Utf8() == text,L"first Save offers Save As and Cancel retains the untitled draft");
        const auto saved = root / L"named-document.cpp"; check(draft->StartSave(saved.wstring()) && Wait(draft) && !draft->untitled_ && draft->document_.Path() == saved.wstring() && ReadDisk(saved) == std::vector<std::uint8_t>(text.begin(),text.end()),L"Save As adopts the named file and commits the exact UTF-8 draft");
        check(!workspace->recent_files_.empty() && workspace->recent_files_.front() == saved.wstring(),L"named Save As joins the recent-file list");
        const auto a = root / L"tab-a.txt", b = root / L"tab-b.txt"; Write(a,{'a'}); Write(b,{'b'}); workspace->OpenPath(a.wstring()); workspace->OpenPath(b.wstring()); auto* active = workspace->sessions_[workspace->active_session_]; workspace->ReorderSessions(0,3);
        check(workspace->sessions_[workspace->active_session_] == active && std::find(workspace->sessions_.begin(),workspace->sessions_.end(),draft) != workspace->sessions_.end() && draft->text_.Utf8() == text,L"tab ordering preserves active session, document controls and draft history");
        const auto a_index = static_cast<int>(std::find_if(workspace->sessions_.begin(),workspace->sessions_.end(),[&](const auto* f) { return f->document_.Path() == a.wstring(); }) - workspace->sessions_.begin()); CRect tab; workspace->sessions_tab_.GetItemRect(a_index,tab); const auto middle = tab.CenterPoint(); workspace->sessions_tab_.SendMessage(WM_MBUTTONUP,0,MAKELPARAM(middle.x,middle.y));
        check(workspace->sessions_.size() == 3 && !workspace->closed_files_.empty() && workspace->closed_files_.front() == a.wstring(),L"middle-click closes only the hit tab and records its reopen path"); workspace->OnReopenClosed(); check(workspace->sessions_.size() == 4 && workspace->sessions_[workspace->active_session_]->document_.Path() == a.wstring(),L"Reopen closed file creates or activates the correct retained editor");
        workspace->ActivateSession(static_cast<int>(std::find(workspace->sessions_.begin(),workspace->sessions_.end(),draft) - workspace->sessions_.begin())); draft->text_.SetSel(0,0); draft->text_.ReplaceSel(L"unsaved ",TRUE); workspace->context_session_ = 0; confirm_command_ = IDCANCEL; timer = ::SetTimer(nullptr,0,40,ConfirmationTimer); workspace->OnTabAction(ID_WORKSPACE_CLOSE_OTHERS);
        const auto pump = [&]() { const auto deadline = std::chrono::steady_clock::now() + std::chrono::seconds(15); while (!workspace->close_queue_.empty() && std::chrono::steady_clock::now() < deadline) { MSG msg{}; while (::PeekMessage(&msg,nullptr,0,0,PM_REMOVE)) { ::TranslateMessage(&msg); ::DispatchMessage(&msg); } for (auto* frame : workspace->sessions_) frame->OnTimer(1); ::Sleep(1); } return workspace->close_queue_.empty(); };
        const auto stopped = pump(); ::KillTimer(nullptr,timer); workspace->context_session_ = -1; check(stopped && std::find(workspace->sessions_.begin(),workspace->sessions_.end(),draft) != workspace->sessions_.end() && draft->text_.GetModify(),L"Cancel during close-many aborts the remaining queue and preserves the draft");
        auto* keeper = workspace->sessions_[0]; workspace->context_session_ = 0; confirm_command_ = IDYES; timer = ::SetTimer(nullptr,0,40,ConfirmationTimer); workspace->OnTabAction(ID_WORKSPACE_CLOSE_OTHERS); const auto finished = pump(); ::KillTimer(nullptr,timer); workspace->context_session_ = -1;
        check(finished && workspace->sessions_.size() == 1 && workspace->sessions_[0] == keeper && ReadDisk(saved).size() > text.size(),L"close-many resumes only after asynchronous Save succeeds and retains its chosen tab");
        workspace->DestroyWindow(); AfxGetApp()->m_pMainWnd = nullptr; check(!std::filesystem::exists(backing) && !std::filesystem::exists(second_backing),L"workspace teardown removes only owned unchanged empty backing files"); return failures;
    }
