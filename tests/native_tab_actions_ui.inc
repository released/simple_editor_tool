    static int RunTabActions(const std::filesystem::path& root,const std::filesystem::path& screenshot = {}) {
        using namespace simple_editor::ui;
        int failures = 0; const auto check = [&](bool ok,const wchar_t* name) { std::wcout << (ok ? L"PASS: " : L"FAIL: ") << name << L'\n'; if (!ok) ++failures; };
        std::wstring error; check(InitializeLocalization(std::filesystem::current_path() / L"src" / L"res",L"tw",&error),L"tab actions load the isolated Traditional Chinese catalog");
        const auto a = root / L"source & header.hpp",b = root / L"other.cpp";
        Write(a,{'i','n','t',' ','f','i','r','s','t','(',')',';','\n'}); Write(b,{'i','n','t',' ','s','e','c','o','n','d',';','\n'});
        auto* workspace = new CWorkspaceFrame(false); AfxGetApp()->m_pMainWnd = workspace;
        workspace->SetWindowPos(nullptr,0,0,1152,780,SWP_NOZORDER | SWP_NOACTIVATE); workspace->ShowWindow(SW_SHOWNOACTIVATE);
        workspace->OpenPath(a.wstring()); auto* first = workspace->sessions_.back(); first->ToggleTextClone();
        first->text_.SetSel(0,0); first->text_.ReplaceSel(L"draft ",TRUE); first->text_.SetSel(1,4);
        const auto draft = first->text_.Utf8(); const auto generation = first->text_.Generation(),revision = first->revision_;
        const auto undo_actions = first->text_.Call(SCI_GETUNDOACTIONS);
        const auto anchor = first->text_.Call(SCI_GETANCHOR),caret = first->text_.Call(SCI_GETCURRENTPOS);
        const auto disk = ReadDisk(a); const auto bytes = Read(first);
        workspace->OpenPath(b.wstring()); auto* second = workspace->sessions_.back();
        workspace->NewDocument(); auto* untitled = workspace->sessions_.back(); workspace->ActivateSession(1);
        auto& tabs = workspace->sessions_tab_;
        const auto index = [&](const CMainFrame* frame) { const auto found = std::find(workspace->sessions_.begin(),workspace->sessions_.end(),frame); return found == workspace->sessions_.end() ? -1 : static_cast<int>(found-workspace->sessions_.begin()); };
        const auto click = [&](int row,CWorkspaceTabs::Action action) { const auto point = tabs.ActionBounds(row,action).CenterPoint(); tabs.SendMessage(WM_LBUTTONDOWN,MK_LBUTTON,MAKELPARAM(point.x,point.y)); tabs.SendMessage(WM_LBUTTONUP,0,MAKELPARAM(point.x,point.y)); };
        const auto lock = CWorkspaceTabs::Action::Lock,close = CWorkspaceTabs::Action::Close;
        LOGFONT font{}; tabs.GetFont()->GetLogFont(&font);
        check(font.lfWeight == FW_NORMAL && std::wstring(font.lfFaceName) == L"Segoe UI",L"owner-drawn tab captions retain the regular interface font");
        CRect overlap; const auto lock_box = tabs.ActionBounds(0,lock),close_box = tabs.ActionBounds(0,close);
        check(!lock_box.IsRectEmpty() && !close_box.IsRectEmpty() && !overlap.IntersectRect(lock_box,close_box),L"each document has distinct lock and close hit regions");
        wchar_t caption[128]{}; TCITEM item{}; item.mask = TCIF_TEXT; item.pszText = caption; item.cchTextMax = _countof(caption); tabs.GetItem(0,&item);
        {
            CRect caption_box,label_box; tabs.GetItemRect(0,&caption_box); CClientDC measure(&tabs); const auto old_font = measure.SelectObject(tabs.GetFont()); measure.DrawText(caption,label_box,DT_CALCRECT | DT_SINGLELINE); const auto caption_width = label_box.Width(); measure.SelectObject(old_font);
            check(std::wstring(caption).find(L"&&") != std::wstring::npos && first->document_.Path() == a.wstring() && lock_box.left-tabs.Scale(2)-(caption_box.left+1+tabs.Scale(7)) >= caption_width,L"filename text including ampersands fits before both icons without changing the source path");
            std::wcout << L"METRIC interface_dpi=" << measure.GetDeviceCaps(LOGPIXELSX) << L" tab_height=" << caption_box.Height() << L" tab_width=" << caption_box.Width() << L" caption_width=" << caption_width << L" caption_room=" << lock_box.left-tabs.Scale(2)-(caption_box.left+1+tabs.Scale(7)) << L'\n';
        }
        click(0,lock);
        check(first->user_read_only_ && first->text_.Call(SCI_GETREADONLY) && first->text_clone_.Call(SCI_GETREADONLY) && first->hex_.ReadOnly(),L"clicking the lock makes Text, shared Text and Hex read-only");
        check(workspace->sessions_[workspace->active_session_] == second && !second->user_read_only_ && !untitled->user_read_only_,L"locking an inactive tab changes only that document without activating it");
        check(first->text_.Utf8() == draft && first->text_.Generation() == generation && first->revision_ == revision && first->text_.Call(SCI_GETUNDOACTIONS) == undo_actions && first->text_.Call(SCI_GETANCHOR) == anchor && first->text_.Call(SCI_GETCURRENTPOS) == caret && Read(first) == bytes && ReadDisk(a) == disk,L"locking retains unsaved text, caret, selection, Undo history and original disk bytes without committing the draft");
        first->text_.ReplaceSel(L"blocked",TRUE); first->hex_.OnChar('F',1,0);
        check(first->text_.Utf8() == draft && Read(first) == bytes,L"locked tab rejects text and Hex mutations");
        const auto hover = lock_box.CenterPoint(); tabs.SendMessage(WM_MOUSEMOVE,0,MAKELPARAM(hover.x,hover.y));
        check(tabs.tooltip_.GetSafeHwnd() && tabs.tooltip_.GetToolCount() == 1 && tabs.tooltip_text_ == L"解除編輯鎖定",L"lock hover registers a localized native tooltip");
        SetUiLanguage(L"en"); check(tabs.ActionText(0,lock) == L"Unlock editing" && tabs.ActionText(0,close) == L"Close this tab",L"action hints follow the current language without translating filenames"); SetUiLanguage(L"tw");
        if (!screenshot.empty()) { workspace->ActivateSession(0); check(ExpansionCapture(*workspace,screenshot),L"capture native lock and close glyphs with retained document content"); workspace->ActivateSession(index(second)); }
        click(0,lock); first->SendMessage(WM_COMMAND,ID_HEX_READ_ONLY);
        check(first->user_read_only_ && first->active_tab_ == 1 && tabs.lock_state(0).locked,L"the existing read-only command also works on Text and keeps the tab glyph synchronized");
        click(0,lock); check(!first->user_read_only_ && !first->text_.Call(SCI_GETREADONLY) && first->text_.CanUndo(),L"unlock restores editing while retaining native Undo");
        first->text_.Undo(); const bool undone = first->text_.Utf8() != draft; first->text_.Redo(); check(undone && first->text_.Utf8() == draft,L"unlock permits actual Undo and Redo of the pre-lock draft");
        const int owner = 1; check(workspace->LockPaths({b.wstring()},true,&owner),L"acquire an isolated operation lock on the clean second document");
        const auto second_index = index(second); click(second_index,lock);
        check(!tabs.lock_state(second_index).enabled && !second->user_read_only_ && second->text_.Call(SCI_GETREADONLY) && tabs.ActionText(second_index,lock).find(L"文件正在執行作業") == 0,L"busy operation locks cannot be bypassed with the tab icon"); workspace->LockPaths({},false,&owner);
        const auto release = close_box.CenterPoint(); tabs.SendMessage(WM_LBUTTONDOWN,MK_LBUTTON,MAKELPARAM(hover.x,hover.y)); tabs.SendMessage(WM_LBUTTONUP,0,MAKELPARAM(release.x,release.y));
        check(workspace->sessions_.size() == 3 && !first->user_read_only_,L"releasing over a different icon cancels the pressed action");
        CRect from,to; tabs.GetItemRect(0,&from); tabs.GetItemRect(2,&to); CPoint begin(from.left+6,from.CenterPoint().y),end(to.left+6,to.CenterPoint().y);
        tabs.SendMessage(WM_LBUTTONDOWN,MK_LBUTTON,MAKELPARAM(begin.x,begin.y)); tabs.SendMessage(WM_MOUSEMOVE,MK_LBUTTON,MAKELPARAM(end.x,end.y)); tabs.SendMessage(WM_LBUTTONUP,0,MAKELPARAM(end.x,end.y));
        check(index(first) == 2 && workspace->sessions_[workspace->active_session_] == first,L"dragging tab text still reorders sessions without invoking an icon");
        click(index(first),lock); check(first->user_read_only_ && !second->user_read_only_,L"lock hit routing follows the document after tab reordering");
        first->ShowPage(0); first->ShowPage(1);
        check(first->user_read_only_ && first->hex_.ReadOnly() && first->text_.Utf8() == draft && first->text_.Call(SCI_GETUNDOACTIONS) == undo_actions,L"locked documents remain viewable across Text and Hex without replacing native Undo history");
        const auto held = tabs.ActionBounds(index(first),close).CenterPoint(); tabs.SendMessage(WM_LBUTTONDOWN,MK_LBUTTON,MAKELPARAM(held.x,held.y));
        workspace->ReorderSessions(index(first),0); tabs.SendMessage(WM_LBUTTONUP,0,MAKELPARAM(held.x,held.y));
        check(workspace->sessions_.size() == 3 && index(first) == 0,L"a tab-order change cancels an already pressed icon instead of closing another document");
        reliability_owner_ = workspace->GetSafeHwnd(); reliability_answer_ = IDCANCEL; const auto timer = ::SetTimer(nullptr,0,20,ReliabilityDialogTimer);
        const auto count = workspace->sessions_.size(); click(index(first),close);
        check(workspace->sessions_.size() == count && index(first) >= 0 && first->text_.Utf8() == draft && first->text_.Call(SCI_GETUNDOACTIONS) == undo_actions,L"X on a locked dirty tab asks about unsaved edits and Cancel preserves the draft and Undo history");
        reliability_answer_ = IDNO; click(index(first),close);
        check(index(first) < 0 && index(second) >= 0 && index(untitled) >= 0,L"discard confirmation closes only the clicked tab");
        auto* comparison = workspace->NewComparisonInputs(a.wstring(),b.wstring(),L"",2,false);
        check(comparison && tabs.ActionBounds(index(comparison),lock).IsRectEmpty() && !tabs.ActionBounds(index(comparison),close).IsRectEmpty(),L"comparison sessions expose X while retaining independent read-only sources and merge semantics");
        if (comparison) click(index(comparison),close);
        const auto second_window = second->GetSafeHwnd(); second->text_.SetSel(0,0); second->text_.ReplaceSel(L"saved ",TRUE);
        check(second->StartSave(b.wstring()),L"start the normal background save before closing through X"); click(index(second),close);
        check(WaitClosed(second,second_window) && index(second) < 0 && index(untitled) >= 0 && ReadDisk(b) != std::vector<std::uint8_t>({'i','n','t',' ','s','e','c','o','n','d',';','\n'}),L"X during Save waits for the committed save and preserves sibling tabs");
        CRect last; tabs.GetItemRect(index(untitled),&last); const auto middle = last.CenterPoint(); tabs.SendMessage(WM_MBUTTONUP,0,MAKELPARAM(middle.x,middle.y));
        check(workspace->sessions_.empty(),L"middle-click closing remains available alongside the new icons");
        ::KillTimer(nullptr,timer); reliability_owner_ = nullptr; workspace->DestroyWindow(); AfxGetApp()->m_pMainWnd = nullptr; return failures;
    }
