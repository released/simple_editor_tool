        auto* frame = new CMainFrame(false); AfxGetApp()->m_pMainWnd = frame; frame->OpenPath(left.wstring()); frame->StartCompare(right.wstring(),false); ::Sleep(100); frame->DrainDifferences(1);
        check(!frame->pending_differences_.empty() && frame->job_.valid() && frame->job_.wait_for(std::chrono::milliseconds(0)) != std::future_status::ready && frame->differences_.GetItemCount() == frame->pending_differences_.size(),L"binary compare displays bounded batches before its worker finishes");
        check(Wait(frame) && frame->pending_differences_.size() == 1000000 && frame->pending_differences_.front().left_offset == 0 && frame->pending_differences_.back().left_offset == 999999 && !frame->difference_mailbox_,L"incremental comparison retains exact ordered addresses through the one-million-row cap");
        frame->StartCompare(right.wstring(),false); ::Sleep(50); frame->DrainDifferences(1); frame->OnCompareCancel(); check(Wait(frame) && frame->pending_differences_.empty() && !frame->difference_mailbox_ && frame->document_.IsOpen(),L"cancelled comparisons remove partial rows and retain the editor input");
